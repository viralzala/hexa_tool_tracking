@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div id="page_content">
    <div id="page_content_inner">
        <h3 class="heading_b uk-margin-bottom">Asset Sub Category 2 Master</h3>

        <form class="uk-form-stacked" id="page_settings">
            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-1">
                            <div class="uk-grid" data-uk-grid-margin>
                                <input type="hidden" name="AssetSubCategory2Id" id="AssetSubCategory2Id" />

                                <div class="uk-width-medium-1-4">
                                    <div class="parsley-row">
                                        <input class="md-btn md-btn-wave waves-effect waves-button premium-input" id="GroupMasterId" name="GroupMasterId" placeholder="Select Asset Category" />
                                        <span class="uk-form-help-block"><b>Asset Category</b></span>
                                    </div>
                                </div>

                                <div class="uk-width-medium-1-4">
                                    <div class="parsley-row">
                                        <input class="md-btn md-btn-wave waves-effect waves-button premium-input" id="AssetSubCategoryId" name="AssetSubCategoryId" placeholder="Select Asset Sub Category 1" />
                                        <span class="uk-form-help-block"><b>Asset Sub Category 1</b></span>
                                    </div>
                                </div>

                                <div class="uk-width-medium-1-4">
                                    <div class="parsley-row">
                                        <label><b> Asset Sub Category 2</b><span class="req"> *</span></label>
                                        <input type="text" value="" required id="AssetSubCategory2Name" name="AssetSubCategory2Name" class="md-input label-fixed" />
                                    </div>
                                </div>

                                <div class="uk-width-medium-1-4">
                                    <div class="parsley-row">
                                        <label>Description</label>
                                        <input type="text" value="" id="Description" name="Description" class="md-input label-fixed" />
                                    </div>
                                </div>

                                <div class="uk-width-large-1-3 uk-width-medium-1-1">
                                    <div class="uk-input-group">
                                        <button title="Add" type="button" id="btnsave" class="md-btn md-btn-primary">
                                            Save
                                        </button>
                                        <button title="Update" type="button" id="btnupdate" class="md-btn md-btn-primary">
                                            Update
                                        </button>
                                        @* <button type="reset" id="btnNew" class="md-btn md-btn-primary">
                                            New
                                        </button> *@
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="md-card uk-margin-medium-bottom">
            <div class="md-card-content">
                <div class="uk-grid" data-uk-grid-margin>
                    <div class="uk-width-medium-1-1">
                        <div class="uk-input-group">
                            <span class="uk-input-group-addon">
                                <i class="uk-icon-search"></i>
                            </span>
                            <div class="md-input-wrapper md-input-filled">
                                <label for="product_edit_quantity_control">Search</label>
                                <input type="text" class="md-input" name="search" id="global_filter">
                                <span class="md-input-bar "></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="md-card uk-margin-medium-bottom">
            <div class="md-card-content">
                <div class="dt_colVis_buttons"></div>
                <table id="tbl" class="uk-table" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Asset Category</th>
                            <th>Asset Sub Category 1</th>
                            <th>Asset Sub Category 2</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>


@section foot
{
    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/AppJs/RFID/AssetSubCategory2.js"></script>

    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
}