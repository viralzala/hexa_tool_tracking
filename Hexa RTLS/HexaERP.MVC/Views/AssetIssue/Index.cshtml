
@{
    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        if (Convert.ToString(Session["SortCode"]) == "SA")
        {
            Layout = "~/Views/Shared/_Site.cshtml";
        }
        else if (Convert.ToString(Session["SortCode"]) == "AD")
        {
            Layout = "~/Views/Shared/_Admin.cshtml";
        }
        else if (new string[] { "OT", "SA" }.Contains(Convert.ToString(Session["SortCode"])))
        {
            Layout = "~/Views/Shared/_Users.cshtml";
        }
    }
    else
    {

    }
}

@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}
<div id="page_content">
    <div id="page_content_inner">
        <h3 class="heading_b uk-margin-bottom">Asset Issue/Stock Tranfer</h3>
        <div class="md-card uk-margin-large-bottom">
            <div class="md-card-content">
                <form class="uk-form-stacked" id="wizard_advanced_form">
                    <div id="wizard_advanced">
                        <section>
                            <h2 class="heading_a">
                                <span class="sub-heading"></span>
                            </h2>
                            <span class="uk-alert uk-alert-info">Make sure reader is ON and for details follow the reader status</span>
                            <div class="uk-grid" data-uk-grid-margin>
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_city">Start Reader</label>
                                    <input id="Reader" name="Reader" required placeholder="Select Reader..." />
                                </div>

                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_address">Attena Port</label>
                                    <input type="text" name="PORTID" id="PORTID" required class="md-input" />
                                </div>
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_city">Start Reader</label>
                                    <a id="startb" onclick="test()" class="md-btn md-btn-facebook md-btn-mini md-btn-icon"><i id="btntst" class="material-icons"></i> </a>
                                </div>
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_zip">GET RFID</label>
                                    <a id="getRfids" onclick="GetId()" href="#mailbox_new_message" class="md-btn md-btn-facebook md-btn-mini md-btn-icon" data-uk-modal="{center:true}"><i class="material-icons">&#xE8C7;</i></a>
                                </div>
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_state">Stop</label>
                                    <a onclick="StopReader()" class="md-btn md-btn-facebook md-btn-mini md-btn-icon"><i class="material-icons">&#xE036;</i></a>
                                </div>
                                <br />
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label for="wizard_vehicle_registration_zip">Clear Data</label>
                                    <a onclick="ClearRdata()" class="md-btn md-btn-facebook md-btn-mini md-btn-icon"><i class="material-icons">&#xE14C;</i></a>
                                </div>
                                <div class="uk-width-medium-1-6 parsley-row">
                                    <label class="uk-alert uk-alert-info"><b>Reader Status</b></label>
                                    <span id="lblerr" class="uk-text-danger uk-margin-remove"></span>
                                </div>
                                <div class="md-fab-wrapper">
                                    <a class="md-fab md-fab-accent" id="btnNew" href="#mailbox_new_message" data-uk-tooltip="{cls:'uk-tooltip-small',pos:'left'}" title="Create New" data-uk-modal="{target:'#modal_full'}"><i class="material-icons"></i></a>
                                </div>
                            </div>
                        </section>

                    </div>
                </form>
            </div>
        </div>

    </div>

</div>


@section foot
{
    <div class="uk-modal uk-modal-card-fullscreen" id="modal_full">
        <div class="uk-modal-dialog uk-modal-dialog-blank">
            <div class="md-card uk-height-viewport">
                <div class="md-card-toolbar">
                    <div class="md-card-toolbar-actions">
                        <div class="md-card-dropdown" data-uk-dropdown="{pos:'bottom-right'}">
                            <i class="md-icon material-icons">&#xE5D4;</i>
                            <div class="uk-dropdown">
                                <ul class="uk-nav">
                                    <li><a id="btnrefresh">Referesh Data</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <span class="md-icon material-icons uk-modal-close">&#xE5C4;</span>
                    <h3 class="md-card-toolbar-heading-text">
                        Make sure count iteam and listed iteams are equal .or else refresh buttom right side
                    </h3>
                </div>
                <div class="md-card-content" ng-app="">
                    <h4 class="heading_a uk-margin-bottom">RFID Reader Data</h4>
                    <div>

                        <ul class="md-list md-list-addon uk-sortable sortable-handler" data-uk-sortable="{group:'connected-group'}" id="idmydb"></ul>

                    </div>

                    <hr />
                    <h4 class="heading_a uk-margin-bottom">Stock Tranfer</h4>
                    <div class="md-card">
                        <div class="md-card-content">
                            <div class="uk-grid" data-uk-grid-margin>
                                <div class="uk-width-medium-1-2">
                                    <h4 class="heading_c uk-margin-bottom">Material Issue <i class="material-icons">&#xE8CC;</i></h4>
                                    <ul class="md-list md-list-addon uk-sortable sortable-handler" data-uk-sortable="{group:'connected-group'}" id="IsueeColl"></ul>
                                    <hr />
                                    <div class="uk-width-medium-1-2 parsley-row">
                                        <label for="wizard_vehicle_registration_address">Customer Name</label>
                                        <input type="text" required class="md-input" name="IssuedTo" id="IssuedTo" />
                                    </div>
                                    <br />
                                    <div class="uk-width-medium-1-6 parsley-row">
                                        <a class="md-btn md-btn-facebook md-btn-mini md-btn-icon" id="btnIsuue">Issue</a>
                                    </div>
                                </div>

                                <div class="uk-width-medium-1-2">
                                    <h4 class="heading_c uk-margin-bottom">Stock Tranfer <i class="material-icons">&#xE0E4;</i></h4>
                                    <ul class="md-list md-list-addon uk-sortable sortable-handler uk-margin-medium-bottom" data-uk-sortable="{group:'connected-group'}" id="TranferColl"></ul>
                                    <hr />
                                    <div class="uk-grid uk-grid-width-medium-1-2 uk-grid-width-large-1-4" data-uk-grid-margin>
                                        <div class="uk-width-medium-2-4 parsley-row">
                                            <div class="uk-input-group">
                                                <span class="uk-input-group-addon">
                                                    <i class="uk-icon-building"></i>
                                                </span>
                                                <label for="wizard_vehicle_registration_city">Floor/Loaction-</label>
                                                <input onchange="GetRooms()" id="mFloorMasterId" name="mFloorMasterId" required placeholder="Select Reader..." />
                                            </div>
                                        </div>
                                        <div class="uk-width-medium-2-4 parsley-row">
                                            <div class="uk-input-group">
                                                <span class="uk-input-group-addon">
                                                    <i class="uk-icon-home"></i>
                                                </span>
                                                <label for="wizard_vehicle_registration_city">Room/Area-</label>
                                                <input id="mRoomMasterId" name="mRoomMasterId" required placeholder="Select Reader..." />
                                            </div>
                                        </div>
                                    </div>
                                    <br />
                                    <div class="uk-width-medium-1-6 parsley-row">
                                        <a class="md-btn md-btn-facebook md-btn-mini md-btn-icon" id="btnTranfer">Tranfer</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <hr />
                    <h5 class="heading_a uk-margin-bottom">Transaction details List</h5>

                    <div class="md-card">
                        <div class="uk-grid" data-uk-grid-margin="">
                            <div class="uk-width-medium-1-3 uk-row-first">
                                <ul class="md-list md-list-addon" id="ntfList"></ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>


    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>





    <script src="~/Content/bower_components/parsleyjs/dist/parsley.min.js"></script>
    <!-- jquery steps -->
    <script src="~/Content/assets/js/custom/wizard_steps.min.js"></script>


    <!--  forms wizard functions -->
    <script src="~/AppJs/RFID/AssetIssue.js"></script>

    <!--  notifications -->
    <script src="~/AppJs/CRM/Notification.js"></script>

    <!-- page specific plugins -->
    <!-- dragula.js -->
    <script src="~/Content/bower_components/dragula.js/dist/dragula.min.js"></script>

    <!--  sortable functions -->
    <script src="~/Content/assets/js/pages/components_sortable.min.js"></script>


}





