
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section head
{
    <!-- additional styles for plugins -->
    <!-- htmleditor (codeMirror) -->
    <link rel="stylesheet" href="~/Content/bower_components/codemirror/lib/codemirror.css">
    <script src="~/Scripts/HexaAgular/ToolsTrackReport.js"></script>

    <!-- additional styles for plugins -->
    <!-- kendo UI -->
    @*<script src="https://js.pusher.com/4.0/pusher.min.js"></script>*@

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css")"
          rel="stylesheet" type="text/css" media="all" />


    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.material.min.css")"
          rel="stylesheet" type="text/css" media="all" id="kendoCSS" />

}
<div id="page_content_inner" ng-controller="ToolsTrackReportCtrl">

    <h3 class="heading_a" ng-bind="'TrackingReport'|translate"></h3>
    <div class="uk-grid" data-uk-grid-margin>
        <div class="uk-width-medium-1-2">
            <div class="md-card">
                <div class="md-card-content">
                    <h3 class="heading_a" ng-bind="'PickDate'|translate"></h3>
                    <div class="uk-grid">
                        <div class="uk-width-large-1-3 uk-width-1-1">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                <label for="uk_dp_start" ng-bind="'StartDate'|translate"></label>
                                <input class="md-input" type="text" ng-model="fromDate" id="uk_dp_start">
                            </div>
                        </div>
                        <div class="uk-width-large-1-3 uk-width-medium-1-1">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                <label for="uk_dp_end" ng-bind="'EndDate'|translate"></label>
                                <input class="md-input" type="text" ng-model="toDate" id="uk_dp_end">
                            </div>
                        </div>
                        <div class="uk-width-large-1-3 uk-width-medium-1-1">
                            <div class="uk-input-group">
                                <a class="md-btn md-btn-primary md-btn-wave-light waves-effect waves-button waves-light" ng-click="oK()">{{'ViewReport'|translate}}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="uk-width-medium-1-2">
            <div class="md-card">
                <div class="md-card-content">
                    <h3 class="heading_a" ng-bind="'TrackMissingTool'|translate">Track Missing Tool</h3>
                    <div class="uk-grid">
                        <div class="uk-width-large-1-3 uk-width-1-1">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon">
                                    <i class="uk-icon-search"></i>
                                </span>
                                <select id="toTooltagId" name="toTooltagId" ng-model="toTooltagId" placeholder="{{'TypeToolsName'|translate}}" class="uk-form-width-medium"></select>
                            </div>
                        </div>
                        <div class="uk-width-large-1-3 uk-width-1-1">
                            <div class="uk-input-group">
                                <input id="kUI_datepicker_a" ng-model="tDate" ng-init="13-04-2017" placeholder="{{'PickDate'|translate}}" />
                            </div>
                        </div>
                        <div class="uk-width-large-1-3 uk-width-1-1">
                            <div class="uk-input-group">
                                <a class="md-btn md-btn-primary md-btn-wave-light waves-effect waves-button waves-light" ng-click="oKs()">{{'ViewReport'|translate}}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="uk-grid" data-uk-grid-margin data-uk-grid-match id="user_profile">
        <div class="uk-width-large-7-10">
            <div class="md-card" id="printablediv">
                <div class="user_heading">
                    <div class="user_heading_menu hidden-print">
                        <div class="uk-display-inline-block" data-uk-dropdown="{pos:'left-top'}">
                            @*<a target="_blank" onclick="javascript:printDiv('printablediv')" id="btnprint" class="btn btn-block btn-info"><i class="md-icon material-icons md-icon-light">&#xE5D4;</i></a>*@
                            <i class="md-icon material-icons md-icon-light">&#xE5D4;</i>
                            <div class="uk-dropdown uk-dropdown-small">
                                <ul class="uk-nav">
                                    @*<li><a class="md-btn md-btn-flat md-btn-flat-primary" href="#" ng-click="export()">PDF</a></li>*@
                                    <li><a class="md-btn md-btn-flat md-btn-flat-primary" ng-click="exportToExcel('#tblReport')">Excel</a></li>
                                    <li><a target="_blank" onclick="javascript:printDiv('printablediv')" id="btnprint" class="md-btn md-btn-flat md-btn-flat-primary"><i class="fa fa-print"></i>Print</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="uk-display-inline-block"><i class="md-icon md-icon-light material-icons" id="page_print">&#xE8ad;</i></div>
                    </div>
                    <div class="user_heading_content">
                        <h2 class="heading_b uk-margin-bottom">
                            <span class="uk-text-truncate" ng-bind="'TrackedReport'|translate"></span>
                            <span class="sub-heading" ng-bind="'rbetween'|translate"></span>
                        </h2>
                        <ul class="user_stats">
                            <li>
                                <h4 class="heading_a">{{bindfromDate ? bindfromDate : "dd-mm-yyyy"}} <span class="sub-heading" ng-bind="'FromDate'|translate"></span></h4>
                            </li>
                            <li>
                                <h4 class="heading_a">{{bindtoDate ? bindtoDate : "dd-mm-yyyy"}}<span class="sub-heading" ng-bind="'ToDate'|translate"></span></h4>
                            </li>
                            <li>
                                <h4 class="heading_a">{{DataLists.length?DataLists.length:0}} <span class="sub-heading" ng-bind="'TotalRecord'|translate"></span></h4>
                            </li>
                            @*<li>
                                       <h4 class="heading_a">{{(DataLists | filter: Iteam.mAttPortId: 0).length}}<span class="sub-heading">Missed Tracked</span></h4>
                                </li>*@
                        </ul>
                    </div>
                </div>
                <div class="user_content">
                    <table class="uk-table" id="tblReport">
                        <thead>
                            <tr class="uk-text-upper">
                                <th ng-bind="'DESCRIPTION'|translate"></th>
                                <th class="uk-text-center"  ng-bind="'Location'|translate"></th>
                                <th class="uk-text-center" ng-bind="'TrackedArea'|translate"></th>
                                <th class="uk-text-center" ng-bind="'Date'|translate"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="uk-table uk-table-nowrap table_check" ng-repeat="Iteam in DataLists track by $index">
                                <td>
                                    <span class="uk-text-large" ng-if="Iteam.ToolName != null">{{ Iteam.ToolName }}</span>
                                    <span class="uk-text-muted uk-text-small" ng-if="Iteam.ToolName != null">,Drawer:<b> {{Iteam.drawer?Iteam.drawer:'N/A'}}</b>,Rack:<b> {{Iteam.drawerrack?Iteam.drawerrack:'N/A'}}</b></span>
                                    <span class="uk-badge uk-badge-warning" ng-if="Iteam.ToolName == null">{{ Iteam.ToolName ? Iteam.ToolName: 'N/A' }}</span>
                                    <span class="uk-text-muted uk-text-small">{{ Iteam.RFID }}</span>
                                </td>
                                <td class="uk-text-center">
                                    <span class="uk-text-muted uk-text-small" ng-if="Iteam.ToolName != null">Area:<b>{{ Iteam.RoomName?Iteam.RoomName:'N/A' }}</b>Drawer:<b>{{ Iteam.drawer?Iteam.drawer:'N/A' }}</b>Rrack:<b>{{ Iteam.drawerrack?Iteam.drawerrack:'N/A' }}</b></span>
                                </td>
                                <td class="uk-text-center">
                                    <span class="uk-text-muted uk-text-small">Floor Name:<b>{{ Iteam.FloorName?Iteam.FloorName:'N/A' }}</b>,Area:<b>{{Iteam.Persent?Iteam.Persent:'N/A'}}</b></span>

                                </td>
                                <td class="uk-text-center">
                                    {{ Iteam.tDate | jsonDate: "yyyy-MM-dd HH:mm:ss" }}
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td><span>{{(DataLists | filter: mAttPortId == "0").length}}</span></td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
        </div>
        <div class="uk-width-large-3-10 hidden-print">
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-margin-medium-bottom">
                        <h3 class="heading_c uk-margin-bottom" ng-bind="'ToolTrackChart'|translate"></h3>
                        <div class="timeline">
                            <div class="timeline_item">
                                <div class="timeline_icon timeline_icon_warning">
                                    <i class="material-icons">&#xE7FE;</i>
                                </div>
                                <div class="timeline_content">
                                    <div>
                                        <strong>
                                        </strong> {{'onDay'|translate}} <a href="#">
                                        </a>
                                    </div>
                                    <div class="timeline_content_addon">
                                        <ul class="md-list">
                                            <li>
                                                <div class="md-list-content">
                                                    <span class="md-list-heading"><a href="#">{{onDates}}</a></span>
                                                    <div class="uk-margin-small-top">
                                                        <table class="uk-table">
                                                            <tr>
                                                                <th ng-bind="'Tracked'|translate"></th>
                                                                <th ng-bind="'Time'|translate"></th>                                                                
                                                            </tr>
                                                            <tbody>
                                                                <tr ng-repeat="Iteam in EmpTrackList">
                                                                    <div ng-if="Iteam.Type != 0">
                                                                        <td>
                                                                            <span class="uk-text-muted uk-text-small" ng-if="Iteam.Type == 0">{{Iteam.ToolName}}</span>
                                                                            <span class="uk-badge uk-badge-warning" ng-if="Iteam.Type == 1">{{Iteam.EmployeeName}}</span>
                                                                        </td>
                                                                        <td>
                                                                            <i class="material-icons">&#xE192;</i> <span class="uk-text-muted uk-text-small">{{ Iteam.tDate | jsonDate: "HH:mm:ss" }}</span>
                                                                            <i class="material-icons">&#xE417;</i> <span class="uk-text-muted uk-text-small">{{Iteam.Persent ? Iteam.Persent:'N/A'}}</span>
                                                                        </td>
                                                                    </div>

                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                        @*<span class="uk-margin-right">
                                                                <span class="uk-text-muted uk-text-small">{{Iteam.ToolName}}</span>
                                                            </span>
                                                            <span class="uk-margin-right">
                                                                <i class="material-icons">&#xE192;</i> <span class="uk-text-muted uk-text-small">{{ Iteam.tDate | jsonDate: "yyyy-MM-dd HH:mm:ss" }}</span>
                                                            </span>
                                                            <span class="uk-margin-right">
                                                                <i class="material-icons">&#xE417;</i> <span class="uk-text-muted uk-text-small">{{Iteam.Persent ? Iteam.Persent:'N/A'}}</span>
                                                            </span>*@
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<a class="md-btn md-btn-flat md-btn-flat-primary" href="#">Show all</a>*@
                </div>
            </div>
        </div>
    </div>
</div>
@section foot
{

    <!-- page specific plugins -->
    <!-- ionrangeslider -->
    <script src="~/Content/bower_components/ion.rangeslider/js/ion.rangeSlider.min.js"></script>
    <!-- htmleditor (codeMirror) -->
    <script src="~/Content/assets/js/uikit_htmleditor_custom.min.js"></script>
    <!-- inputmask-->
    <script src="~/Content/bower_components/jquery.inputmask/dist/jquery.inputmask.bundle.js"></script>
    <!--  forms advanced functions -->
    <script src="~/Content/assets/js/pages/forms_advanced.min.js"></script>

    <!-- page specific plugins -->
    <!-- kendo UI -->
    <script src="@Url.Content("~/Content/assets/js/kendoui_custom.min.js")"
            type="text/javascript"></script>

    <!--  kendoui functions -->
    <script src="@Url.Content("~/Content/assets/js/pages/kendoui.min.js")"
            type="text/javascript"></script>

    <script>
        function printDiv(divID) {
            var divElements = document.getElementById(divID).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = "<html><head><title></title></head><body>" + divElements + "</body>";
            window.print();
            document.body.innerHTML = oldPage;
        }
    </script>

