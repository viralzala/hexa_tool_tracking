                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE55B;</i> Map Chart</h3></div>
                        <div class="ea-chart-box" id="ea-chart-map" style="display:flex;align-items:center;justify-content:center;color:#999;font-size:14px;">
                            <i class="material-icons" style="font-size:48px;margin-bottom:8px;">&#xE55B;</i>
                            <div>Geographic Distribution Map</div>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions Table -->
                <div class="ea-card" style="margin-bottom:24px;">
                    <div class="ea-card-hdr">
                        <h3><i class="material-icons">&#xE8B0;</i> Recent Transactions</h3>
                        <div style="display:flex;gap:8px;">
                            <span class="ea-export-btn" ng-click="exportData('transactions')"><i class="material-icons" style="font-size:16px;">&#xE24E;</i> Excel</span>
                            <span class="ea-export-btn" ng-click="exportData('assets')"><i class="material-icons" style="font-size:16px;">&#xE24D;</i> PDF</span>
                        </div>
                    </div>
                    <div class="ea-table-wrap">
                        <table class="ea-table" ng-if="transactions.length > 0">
                            <thead>
                                <tr>
                                    <th>#</th><th>Issue Date</th><th>Return Date</th><th>Created By</th><th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="t in transactions track by $index">
                                    <td>{{$index + 1}}</td>
                                    <td>{{formatDate(t.IssueDateDisplay)}}</td>
                                    <td>{{formatDate(t.ReturnDateDisplay)}}</td>
                                    <td>{{t.CreatedBy}}</td>
                                    <td><span class="ea-status-badge info">Completed</span></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="ea-empty" ng-if="transactions.length === 0" style="padding:40px;">
                            <i class="material-icons">&#xE8B0;</i><p>No transactions found</p>
                        </div>
                    </div>
                </div>

                <!-- Latest Assets Table -->
                <div class="ea-card" style="margin-bottom:24px;">
                    <div class="ea-card-hdr">
                        <h3><i class="material-icons">&#xE86E;</i> Latest Assets</h3>
                        <span class="ea-export-btn" ng-click="exportData('assets')"><i class="material-icons" style="font-size:16px;">&#xE24E;</i> Export</span>
                    </div>
                    <div class="ea-table-wrap">
                        <table class="ea-table" ng-if="latestAssets.length > 0">
                            <thead>
                                <tr>
                                    <th>Name</th><th>Model</th><th>Serial</th><th>Department</th><th>Created By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="a in latestAssets track by $index">
                                    <td>{{a.IteamName}}</td>
                                    <td>{{a.ModelNo}}</td>
                                    <td>{{a.SerialNo}}</td>
                                    <td>{{a.OwnerDepartment}}</td>
                                    <td>{{a.CreatedBy}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="ea-empty" ng-if="latestAssets.length === 0" style="padding:40px;">
                            <i class="material-icons">&#xE86E;</i><p>No assets found</p>
                        </div>
                    </div>
                </div>
            </div>

