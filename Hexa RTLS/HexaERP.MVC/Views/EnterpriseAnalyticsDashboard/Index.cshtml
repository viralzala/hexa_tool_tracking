                        <div class="ea-chart-box"><div id="ea-chart-hbar"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE86E;</i> Area Chart - Maintenance</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-area"></div></div>
                    </div>
                </div>

                <!-- Chart Row 3: Spline & Mixed -->
                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
                    <div class="ea-card">
