                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Due Today</h3></div>
                    <div style="padding:16px;">
                        <div ng-if="dueTodayItems.length > 0" style="max-height:200px;overflow-y:auto">
                            <ul class="ea-alert-list">
                                <li ng-repeat="item in dueTodayItems">
                                    <span class="ea-alert-dot" ng-class="{'blue': item.Type === 'Calibration', 'green': item.Type === 'Inspection', 'red': item.Type === 'Maintenance'}"></span>
                                    <div class="ea-alert-content">
                                        <div class="ea-alert-title">{{item.Type}}: {{item.Name}}</div>
                                        <div class="ea-alert-meta">{{item.Date}}</div>
                                    </div>
                                    <span class="ea-alert-badge due">Today</span>
                                </li>
                            </ul>
                        </div>
                        <div class="ea-empty" ng-if="dueTodayItems.length === 0">
                            <i class="material-icons">&#xE8AF;</i><p>No items due today</p>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Alerts -->
                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE7F4;</i> Upcoming Alerts</h3></div>
                    <div style="padding:16px;">
