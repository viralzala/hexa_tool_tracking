                        <div class="ea-chart-box"><div id="ea-chart-calendar"></div></div>
                    </div>
                </div>

                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Progress Chart</h3></div>
                        <div class="ea-chart-box" id="ea-chart-progress"></div>
                    </div>
