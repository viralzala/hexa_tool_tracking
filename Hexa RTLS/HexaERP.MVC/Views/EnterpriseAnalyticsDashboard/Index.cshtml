                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Latest Calibrations</h3></div>
                    <div style="padding:16px;">
                        <ul class="ea-act-list" ng-if="latestCalibrations.length > 0">
                            <li ng-repeat="c in latestCalibrations | limitTo:5">
                                <div class="ea-act-dot orange"><i class="material-icons">&#xE8B0;</i></div>
                                <div class="ea-act-content">
                                    <div class="ea-act-title">{{c.CertificateNo || 'Calibration'}}</div>
