                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE86E;</i> Latest Maintenance</h3></div>
                    <div style="padding:16px;">
                        <ul class="ea-act-list" ng-if="latestMaintenance.length > 0">
                            <li ng-repeat="m in latestMaintenance | limitTo:5">
                                <div class="ea-act-dot red"><i class="material-icons">&#xE86E;</i></div>
                                <div class="ea-act-content">
                                    <div class="ea-act-title">{{m.Title}}</div>
                                    <div class="ea-act-meta">{{m.CreatedBy}} - Cost: &#8377;{{m.Cost}}</div>
                                </div>
                            </li>
                        </ul>
                        <div class="ea-empty" ng-if="latestMaintenance.length === 0">
                            <i class="material-icons">&#xE86E;</i><p>No maintenance records</p>
                        </div>
                    </div>
                </div>

                <!-- Overdue Items -->
                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE7F4;</i> Overdue Items</h3></div>
                    <div style="padding:16px;">
                        <div ng-if="overdueCalibrations.length > 0 || overdueInspections.length > 0">
                            <p style="font-size:12px;font-weight:600;color:#e53935;margin:0 0 8px;">Overdue Calibrations</p>
                            <ul class="ea-alert-list" ng-if="overdueCalibrations.length > 0">
                                <li ng-repeat="c in overdueCalibrations | limitTo:5">
                                    <span class="ea-alert-dot red"></span>
                                    <div class="ea-alert-content">
                                        <div class="ea-alert-title">{{c.CertificateNo}}</div>
                                        <div class="ea-alert-meta">{{c.DaysOverdue}} days overdue</div>
                                    </div>
                                    <span class="ea-alert-badge overdue">Overdue</span>
                                </li>
                            </ul>
                        </div>
                        <div class="ea-empty" ng-if="overdueCalibrations.length === 0 && overdueInspections.length === 0">
                            <i class="material-icons">&#xE7F4;</i><p>No overdue items</p>
                        </div>
                    </div>
                </div>

                <!-- Recent Login Users -->
                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE7FD;</i> Recent Login Users</h3></div>
                    <div style="padding:16px;">
                        <ul class="ea-act-list" ng-if="recentLogins.length > 0">
                            <li ng-repeat="u in recentLogins | limitTo:5">
                                <div class="ea-act-dot teal"><i class="material-icons">&#xE7FD;</i></div>
                                <div class="ea-act-content">
                                    <div class="ea-act-title">{{u.AppUserName}}</div>
                                    <div class="ea-act-meta">{{u.EmailId}} - {{u.LastLogin}}</div>
                                </div>
                            </li>
                        </ul>
                        <div class="ea-empty" ng-if="recentLogins.length === 0">
                            <i class="material-icons">&#xE7FD;</i><p>No recent logins</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot{
    <script src="~/Scripts/HexaAgular/EnterpriseAnalyticsDashboard.js"></script>
}