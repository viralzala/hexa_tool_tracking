                        <div class="ea-chart-box"><div id="ea-chart-line"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Bar Chart - Calibrations</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-bar"></div></div>
                    </div>
                </div>

                <!-- Chart Row 2: Horizontal Bar & Area -->
                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
