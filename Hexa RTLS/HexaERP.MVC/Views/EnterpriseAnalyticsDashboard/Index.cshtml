                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Scatter Chart</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-scatter"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Bubble Chart</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-bubble"></div></div>
                    </div>
                </div>

                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Heatmap</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-heatmap"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Treemap</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-treemap"></div></div>
                    </div>
                </div>

                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Funnel Chart</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-funnel"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Stacked Bar</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-stacked"></div></div>
                    </div>
                </div>

                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
