                        <div class="ea-chart-box"><div id="ea-chart-radar"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Radial Bar</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-radial"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Gauge Chart</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-gauge"></div></div>
                    </div>
                </div>

                <!-- More Charts Row -->
                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
