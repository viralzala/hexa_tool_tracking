                                <div class="ea-act-content">
                                    <div class="ea-act-title">{{i.InspectionNo}} <span ng-if="i.Status" style="font-size:10px;color:#e65100">{{i.Status}}</span></div>
                                    <div class="ea-act-meta">{{i.CreatedBy}} - {{formatDate(i.InspectionDateDisplay)}}</div>
                                </div>
                            </li>
                        </ul>
                        <div class="ea-empty" ng-if="latestInspections.length === 0">
                            <i class="material-icons">&#xE86C;</i><p>No inspections</p>
                        </div>
                    </div>
                </div>

