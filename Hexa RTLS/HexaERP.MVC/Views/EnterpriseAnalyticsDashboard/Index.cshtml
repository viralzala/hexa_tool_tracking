                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE8B1;</i> Weekly Trend</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-weekly"></div></div>
                    </div>
                    <div class="ea-card">
                        <div class="ea-card-hdr"><h3><i class="material-icons">&#xE192;</i> Yearly Trend</h3></div>
                        <div class="ea-chart-box"><div id="ea-chart-yearly"></div></div>
                    </div>
                </div>

                <!-- Chart Row 1: Line & Bar -->
                <div class="ea-row ea-row-2" style="margin-bottom:24px;">
