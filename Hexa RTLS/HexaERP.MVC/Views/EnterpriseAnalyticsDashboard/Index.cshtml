                            <p style="font-size:12px;font-weight:600;color:#1a237e;margin:0 0 8px;">Calibration Due</p>
                            <ul class="ea-alert-list" ng-if="upcomingCalibrations.length > 0">
                                <li ng-repeat="c in upcomingCalibrations | limitTo:5">
                                    <span class="ea-alert-dot orange"></span>
                                    <div class="ea-alert-content">
                                        <div class="ea-alert-title">{{c.AssetName || c.CertificateNo}}</div>
                                        <div class="ea-alert-meta">Due: {{formatDate(c.DueDateDisplay)}}</div>
                                    </div>
                                    <span class="ea-alert-badge due">Due</span>
                                </li>
                            </ul>
                            
                            <p style="font-size:12px;font-weight:600;color:#01579b;margin:12px 0 8px;">Inspection Due</p>
                            <ul class="ea-alert-list" ng-if="upcomingInspections.length > 0">
                                <li ng-repeat="i in upcomingInspections | limitTo:5">
                                    <span class="ea-alert-dot green"></span>
                                    <div class="ea-alert-content">
                                        <div class="ea-alert-title">{{i.InspectionNo}}</div>
                                        <div class="ea-alert-meta">{{formatDate(i.InspectionDateDisplay)}}</div>
                                    </div>
                                    <span class="ea-alert-badge due">Due</span>
                                </li>
                            </ul>
                            
                            <p style="font-size:12px;font-weight:600;color:#c62828;margin:12px 0 8px;">Maintenance Due</p>
                            <ul class="ea-alert-list" ng-if="upcomingMaintenance.length > 0">
                                <li ng-repeat="m in upcomingMaintenance | limitTo:5">
                                    <span class="ea-alert-dot red"></span>
                                    <div class="ea-alert-content">
                                        <div class="ea-alert-title">{{m.WorkOrderNo}}</div>
                                        <div class="ea-alert-meta">Due: {{formatDate(m.DueDateDisplay)}}</div>
                                    </div>
                                    <span class="ea-alert-badge due">Due</span>
                                </li>
                            </ul>
                        </div>
                        <div class="ea-empty" ng-if="upcomingCalibrations.length === 0 && upcomingInspections.length === 0 && upcomingMaintenance.length === 0">
                            <i class="material-icons">&#xE7F4;</i><p>No upcoming alerts</p>
                        </div>
                    </div>
                </div>

