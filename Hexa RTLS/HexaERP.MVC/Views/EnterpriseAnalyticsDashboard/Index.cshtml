                    <a href="/AssetIssue" class="ea-qaction"><i class="material-icons">&#xE2C4;</i><span>Issue Asset</span></a>
                    <a href="/MoreAssetDetail" class="ea-qaction"><i class="material-icons">&#xE2C6;</i><span>Return Asset</span></a>
                    <a href="/AssetCalibration" class="ea-qaction"><i class="material-icons">&#xE8B0;</i><span>Calibration</span></a>
                    <a href="/AssetInspection" class="ea-qaction"><i class="material-icons">&#xE86C;</i><span>Inspection</span></a>
                    <a href="/MoreAssetDetail" class="ea-qaction"><i class="material-icons">&#xE86E;</i><span>Maintenance</span></a>
                    <a href="/AssetsReport" class="ea-qaction"><i class="material-icons">&#xE8B0;</i><span>Reports</span></a>
