                <div class="ea-card">
                    <div class="ea-card-hdr"><h3><i class="material-icons">&#xE889;</i> Latest Activities</h3></div>
                    <div style="padding:16px;">
                        <ul class="ea-act-list" ng-if="latestAssets.length > 0">
                            <li ng-repeat="a in latestAssets | limitTo:5">
                                <div class="ea-act-dot blue"><i class="material-icons">&#xE86E;</i></div>
                                <div class="ea-act-content">
                                    <div class="ea-act-title">{{a.IteamName}} - {{a.ModelNo}}</div>
                                    <div class="ea-act-meta">Added by {{a.CreatedBy}} - {{formatDate(a.CreatedDateDisplay)}}</div>
                                </div>
                            </li>
                        </ul>
                        <div class="ea-empty" ng-if="latestAssets.length === 0">
                            <i class="material-icons">&#xE889;</i><p>No activities</p>
                        </div>
                    </div>
                </div>

