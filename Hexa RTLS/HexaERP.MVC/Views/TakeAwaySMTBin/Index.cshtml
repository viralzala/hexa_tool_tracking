@{
    /**/

    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        Layout = "~/Views/Shared/_Admin.cshtml";
    }
    else
    {
        Response.Redirect("/AppUser");
    }
}

@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div ng-controller="TakeAwaySMTBinCtrl">
    <div id="page_content">
        <div id="page_content_inner">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "resetForm", @name = "resetForm" }))
            {
                <h3 class="heading_b uk-margin-bottom">Bin Out</h3>
                <div class="uk-grid" data-uk-grid-margin>
                    <div class="uk-width-large-2-10 hidden-print">
                        <div class="md-card">
                            <div class="scrum_task critical">
                                <h3 class="scrum_task_title">Note:</h3>
                                <p class="scrum_task_description">Put curser on textbox and scan QR Code</p>
                            </div>
                            <div class="md-card-content">
                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">

                                        <div class="uk-width-1-1">
                                            <div class="parsley-row">

                                                <span class="uk-form-help-block">
                                                    <b>
                                                        Employee ID
                                                    </b>
                                                </span>

                                                <input type="text" required
                                                       class="md-input label-fixed"
                                                       focus-on="ModifiedBy"
                                                       name="ModifiedBy"
                                                       id="ModifiedBy"
                                                       placeholder="Scan Employee Id/Name"
                                                       ng-model="ModifiedBy" />
                                            </div>
                                        </div>
                                        <div class="uk-width-1-1">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <i class="uk-icon-barcode"></i>
                                                    <b>
                                                        Part Number
                                                    </b>
                                                </span>
                                                <input type="text"
                                                       placeholder="Scan Part Number"
                                                       required
                                                       class="md-input label-fixed"
                                                       focus-on="PartNumber"
                                                       name="PartNumber"
                                                       id="PartNumber"
                                                       ng-model="PartNumber" />
                                            </div>
                                        </div>
                                        <div class="uk-width-1-1">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <b>
                                                        Quantity
                                                    </b>
                                                </span>
                                                <input type="number" placeholder="Enter Quantity" min="1"
                                                       required class="md-input label-fixed" focus-on="Quantity" name="Quantity" id="Quantity" ng-model="Quantity" />
                                            </div>

                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <b>
                                                        <br />
                                                    </b>
                                                </span>
                                                <button title="Submit" type="button" ng-click="GetTakeAwayList()"
                                                        class="md-btn md-btn-primary">
                                                    {{loading ? loading : 'Get Bin Out'}}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="uk-width-large-8-10 uk-row-first">
                        <div class="md-card">
                            <div class="md-card-content">
                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-1-2">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <i class="uk-icon-barcode"></i>
                                                    <b>
                                                        Bin Ble
                                                    </b>
                                                </span>
                                                <input type="text"
                                                       title="Scan Bin Ble"
                                                       required
                                                       placeholder="Scan Bin Ble"
                                                       class="md-input label-fixed"
                                                       name="Ble"
                                                       id="Ble"
                                                       ng-model="Ble" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-medium-1-1 uk-row-first">
                                            <div class="uk-overflow-container">
                                                <table id="example1" class="uk-table uk-table-nowrap table_check">
                                                    <thead>
                                                        <tr>
                                                            <th><b>Shelf Name</b></th>
                                                            <th><b>Ble Tag</b></th>
                                                            <th>Lot</th>
                                                            <th>Staus</th>
                                                            <th> <b> Part Number</b></th>
                                                            <th><b>Qty</b></th>
                                                            <th><b>Pro Date</b></th>
                                                            <th><b>Serial/Lot No</b></th>
                                                            <th><b>Date</b></th>
                                                            <th><b>Timestamp</b></th>
                                                            <th><b>Created By</b></th>
                                                            @*<th>

                                                                </th>*@
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="i in GetAwayList">
                                                            <td class="uk-text-nowrap" style="background:#333">
                                                                <p class="uk-text-contrast uk-margin-remove center">
                                                                    {{i.ShelfName}}
                                                                </p>
                                                            </td>
                                                            <td>
                                                                <span class="nr">{{i.Ble}}</span>
                                                            </td>
                                                            <td>{{i.Lot}}</td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary"> {{i.Status}}</span>
                                                            </td>
                                                            <td> {{i.PartNumber}}</td>
                                                            <td>
                                                                <span>{{i.Quantity}}</span>
                                                            </td>
                                                            <td>{{i.DateAndTime | jsonDate:'dd MMMM yy'}}</td>
                                                            <td>
                                                                {{i.SerialNumber}}
                                                            </td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary">
                                                                    {{i.ModifiedDate | jsonDate:"dd MMMM yy"}}
                                                                </span>

                                                            </td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary">
                                                                    {{i.ModifiedDate | jsonDate: "hh:mm a"}}
                                                                </span>

                                                            </td>
                                                            <td>
                                                                <span class="uk-badge uk-badge-warning"> {{i.ModifiedBy}}</span>
                                                            </td>

                                                            @*<td>
                                                                    <input id="chkTakeAway_{{i.mSMTProductId}}"
                                                                           type="checkbox"
                                                                           data-md-icheck
                                                                           class="chkTakeAway-ichecked-id"
                                                                           value={{i.mSMTProductId}}>
                                                                </td>*@
                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr ng-if="Quantity != 0">
                                                            <td colspan="9">
                                                                <div class="uk-input-group">
                                                                    <strong class="uk-form-label">Requested Qty. {{Quantity}}</strong>
                                                                </div>
                                                                <div class="uk-input-group">
                                                                    <strong class="uk-form-label">Available  Qty. {{_avialbeQuantity}}</strong>
                                                                </div>
                                                            </td>                                                           
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @*<div class="md-card">
                                <div class="md-card-content">
                                    dd
                                </div>
                            </div>*@
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section foot
{

    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
    <script src="~/Scripts/HexaAgular/SMT/TakeAwaySMTBin.js"></script>
    @*<script type="text/javascript">
            $(function () {
                document.getElementById('ReaderNo').focus();
            });

        </script>*@

}