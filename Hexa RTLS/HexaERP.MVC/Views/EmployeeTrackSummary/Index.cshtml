    <script>
        function printDiv(divID) {
            var divElements = document.getElementById(divID).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = "<html><head><title></title></head><body>" + divElements + "</body>";
            window.print();
            document.body.innerHTML = oldPage;
        }
    </script>

    <script>
        $(document).ready(function () {
            //$("#dateFrom").val(new Date().toJSON().slice(0, 19));
            //$("#toDate").val(new Date().toJSON().slice(0, 19));
            var d = new Date();
            //console.log(d);
            function zeroPadded(val) {
                if (val >= 10)
                    return val;
                else
                    return '0' + val;
            }
            $("#dateFrom").val(d.getFullYear() + "-" + zeroPadded(d.getMonth() + 1) + "-" + zeroPadded(d.getDate() - 1) + "T" + d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds());
            $('#toDate').val(d.getFullYear() + "-" + zeroPadded(d.getMonth() + 1) + "-" + zeroPadded(d.getDate()) + "T" + d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds());
            //var d = new Date();
            //d = (new Date().toISOString().substring(0, 10) + " " + ('0' + d.getHours()).slice(-2) + ":" + ('0' + d.getMinutes()).slice(-2) + " " + (d.getHours() >= 12 ? 'PM' : 'AM'));
            //$("#dateFrom").val(d);
            //$("#kUI_datetimepicker_range_end").val(d);

        });
    </script>
