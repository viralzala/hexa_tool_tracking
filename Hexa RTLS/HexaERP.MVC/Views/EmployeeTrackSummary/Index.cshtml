@{
    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        if (Convert.ToString(Session["SortCode"]) == "SA")
        {
            Layout = "~/Views/Shared/_Site.cshtml";
        }
        else if (Convert.ToString(Session["SortCode"]) == "AD")
        {
            Layout = "~/Views/Shared/_Admin.cshtml";
        }
        else if (new string[] { "OT", "SA" }.Contains(Convert.ToString(Session["SortCode"])))
        {
            Layout = "~/Views/Shared/_Users.cshtml";
        }
    }
    else
    {

    }
}


