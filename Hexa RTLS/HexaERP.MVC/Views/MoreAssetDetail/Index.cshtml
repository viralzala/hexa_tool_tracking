                                                            <div class="uk-grid">
                                                                <div class="uk-width-1-1">
                                                                    <div class="uk-grid uk-grid-width-1-1 uk-grid-width-large-1-1" data-uk-grid-margin>
                                                                        <div class="uk-overflow-container">
                                                                            <table class="premium-table">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th class="uk-text-nowrap"><b>Title</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Maintenance Type</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Maintenance Part</b></th>
                                                                                        <th class="uk-text-nowrap"><i class="uk-icon-inr"></i> <b>Cost</b></th>
                                                                                        <th class="uk-text-nowrap"><b>IsWarranty</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Additional Part</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Created By</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Start Date</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Completion Date</b></th>
                                                                                        <th class="uk-text-nowrap"><b>Note</b></th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    <tr class="uk-table-middle" ng-repeat="mnt in MaintInfo">
                                                                                        <td>{{mnt.Title}}</td>
                                                                                        <td class="uk-text-small">{{mnt.MaintenanceName}}</td>
                                                                                        <td class="uk-text-small">{{mnt.MaintenanPart}}</td>
                                                                                        <td><i class="uk-icon-inr"></i><b> {{mnt.Cost}}</b></td>
                                                                                        <td>
                                                                                            <span class="uk-badge" ng-if="mnt.IsWarranty != null">{{mnt.IsWarranty}}</span>
                                                                                        </td>
                                                                                        <td>{{mnt.AdditionalPart}}</td>
                                                                                        <td>{{mnt.CreatedBy}}</td>
                                                                                        <td class="uk-text-small">{{mnt.StartDate | jsonDate:'dd MMMM yy'}}</td>
                                                                                        <td class="uk-text-small">{{mnt.EndDate | jsonDate:'dd MMMM yy'}}</td>
                                                                                        <td class="uk-text-small">{{mnt.Note}}</td>
                                                                                    </tr>
                                                                                </tbody>
                                                                            </table>
