                                                                                            <span class="uk-input-group-addon">
                                                                                                <i class="uk-icon-calendar"></i>
                                                                                            </span>
                                                                                            <label for="wizard_address"><b>Completion Date</b></label>
                                                                                            <input type="date" name="EndDate" class="md-input label-fixed" />
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="uk-width-medium-1-4">
                                                                                        <div class="parsley-row">
                                                                                            <label for="wizard_address"><b>Maintenance Part</b></label>
                                                                                            <textarea name="MaintenanPart" cols="30" rows="4" class="md-input label-fixed" id="MaintenanPart" ng-model="MaintenanPart"></textarea>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="uk-width-medium-1-4">
                                                                                        <div class="parsley-row">
                                                                                            <label for="wizard_address"><b>Additional Part</b></label>
                                                                                            <textarea name="AdditionalPart" id="AdditionalPart" cols="30" rows="4" class="md-input label-fixed" ng-model="AdditionalPart"></textarea>
