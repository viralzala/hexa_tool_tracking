                                                                                                <i class="uk-icon-inr"></i>
                                                                                            </span>
                                                                                            <label for="wizard_address"><b>Cost</b></label>
                                                                                            <input type="number" name="Cost" id="Cost" ng-model="Cost" required class="md-input label-fixed" />
                                                                                        </div>
                                                                                    </div>
