                                                                                                <i class="uk-icon-calendar"></i>
                                                                                            </span>
                                                                                            <label for="wizard_address"><b>Start Date</b></label>
                                                                                            <input type="date" name="StartDate" class="md-input label-fixed" />
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="uk-width-medium-1-4">
