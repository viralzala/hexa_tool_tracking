
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}


@section head
{
    <!-- htmleditor (codeMirror) -->
    <link href="@Url.Content("~/Content/bower_components/codemirror/lib/codemirror.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.material.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css")"
          rel="stylesheet" type="text/css" media="all" />

}
<div ng-controller="ZoneMasterCtrl">
    <div id="page_content">
        <div id="page_content_inner">
            <h3 class="heading_b uk-margin-bottom">Zone Master</h3>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "_formColl", @name = "_formColl" }))
            {
                @*@Html.AntiForgeryToken()*@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="md-card uk-margin-medium-bottom">
                    <div class="md-card-content">
                        <div class="uk-grid" data-uk-grid-margin>
                            <div class="uk-width-medium-1-1">
                                <div class="uk-grid" data-uk-grid-margin>


                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <select id="mSiteMasterId" name="mSiteMasterId" ng-model="mSiteMasterId" ng-disabled="enableMe=false" placeholder="Select Location" data-placeholder="Site">
                                            </select>
                                            <span class="uk-form-help-block"><b>Location</b></span>
                                        </div>
                                    </div>

                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <input type="text" name="mZoneId" ng-model="mZoneId" ng-hide="true" />
                                            <label><b> Zone</b><span class="req"> *</span></label>
                                            <input type="text" placeholder="Enter Zone Name" required name="Zone" ng-model="Zone" class="md-input label-fixed" />
                                        </div>
                                    </div>
                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <label>Required Logical Shelf?</label>
                                            <span class="uk-input-group-addon">
                                                <hr />
                                                <input name="IsAction"
                                                       id="IsAction"
                                                       value="true"
                                                       type="checkbox"
                                                       placeholder="Required Logical Shelf?"
                                                       data-md-icheck />
                                            </span>
                                        </div>
                                    </div>
                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <input type="number"
                                                   name="OrgInfoId"
                                                   id="OrgInfoId"
                                                   placeholder="Number of row"
                                                   class="md-input label-fixed" />
                                        </div>
                                    </div>
                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <input type="text"
                                                   name="CreatedBy"
                                                   id="CreatedBy"
                                                   placeholder="Shelf Pre Fix"
                                                   class="md-input label-fixed" />
                                        </div>
                                    </div>
                                    <div class="uk-input-group">
                                        <div class="parsley-row">
                                            <button title="Add" type="button" ng-click="SaveFormCollData()" ng-hide="isAdd"
                                                    class="md-btn md-btn-primary">
                                                {{loading ? loading : 'Add'}}
                                            </button>

                                            <button title="Update" type="button" ng-click="EditFormCollData();" ng-init="isEdit=true" ng-hide="isEdit"
                                                    class="md-btn md-btn-primary">
                                                {{loading ? loading : 'Update'}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-1">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon">
                                    <i class="uk-icon-search"></i>
                                </span>
                                <div class="md-input-wrapper md-input-filled">
                                    <label for="product_edit_quantity_control">Search</label>
                                    <input type="text" class="md-input" name="search" id="global_filter">
                                    <span class="md-input-bar "></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="dt_colVis_buttons"></div>
                    <table id="tbls" class="uk-table" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Location</th>
                                <th>Zone</th>
                                <th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot
{

    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
    <script src="~/Scripts/HexaAgular/Zone.js"></script>
}

