
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}


@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div ng-controller="AssignWorkCtrl">
    <div id="page_content">
        <div id="page_content_inner">
            <h3 class="heading_b uk-margin-bottom">Assign Work Locatons for Employee</h3>
            <div class="scrum_task critical">
                <h3 class="scrum_task_title">Note:</h3>
                <p class="scrum_task_description">Enter "all" in the Employee Name text box to get all record</p>
            </div>
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "_formColl", @name = "_formColl" }))
            {
                @*@Html.AntiForgeryToken()*@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="md-card uk-margin-medium-bottom">
                    <div class="md-card-content">
                        <div class="uk-grid" data-uk-grid-margin>
                            <div class="uk-width-medium-1-1">
                                <div class="uk-grid" data-uk-grid-margin>
                                    <div class="uk-width-medium-1-4">

                                        <input type="text" name="tEmployeeTagId" ng-model="tEmployeeTagId" ng-hide="true" />
                                        <div class="parsley-row">

                                            <label> <i class="uk-icon-search"></i> <b>  Employee Name</b><span class="req"> </span></label>
                                            <input type="text" required name="EmployeeName" ng-model="EmployeeName" class="md-input label-fixed" />
                                        </div>
                                    </div>

                                    <div class="uk-width-medium-1-4">
                                        <div class="parsley-row">
                                            <label><b> Employee No</b><span class="req"> </span></label>
                                            <input type="text" required name="EmployeeId" ng-model="EmployeeId" class="md-input label-fixed" />
                                        </div>
                                    </div>

                                    <div class="uk-width-large-1-3 uk-width-medium-1-1">
                                        <div class="uk-input-group">
                                            <button title="Search" type="button" ng-click="SaveFormCollData()" ng-hide="isAdd"
                                                    class="md-btn md-btn-primary">
                                                {{loading ? loading : 'Search'}}
                                            </button>

                                            <button title="Update" type="button" ng-click="EditFormCollData();" ng-init="isEdit=true" ng-hide="isEdit"
                                                    class="md-btn md-btn-primary">
                                                {{loading ? loading : 'Update'}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }



            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="uk-overflow-container">
                        <table id="example1" class="uk-table uk-table-nowrap table_check">
                            <thead>
                                <tr>

                                    <th></th>
                                    <th><b>Employee Name</b></th>
                                    <th> <b> EMP Id</b></th>
                                    <th><b>Agency</b></th>
                                    <th><b>Designation</b></th>
                                    <th><b>Skill Category</b></th>
                                    <th><b>Work Category</b></th>
                                    <th><b>Activity</b></th>
                                    <th><b>Shift</b></th>
                                    <th><b>Site</b></th>
                                    <th><b>Zone</b></th>
                                    <th></th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="i in EmplyeesLists">

                                    <td></td>
                                    <td><i class="md-icon material-icons" title="{{i.EmployeeName}}">&#xE8A3;</i>  {{i.EmployeeName}}</td>
                                    <td>{{i.EmployeeId}}</td>
                                    <td>{{i.Agency}}</td>
                                    <td>{{i.Designation}}</td>
                                    <td>
                                        {{i.SkillCategory}}

                                    </td>
                                    <td>{{i.WorkCategory}}</td>

                                    <td>{{i.Activity}}</td>
                                    <td>{{i.Shift}}</td>
                                    <td>
                                        {{i.Site}}
                                    </td>
                                    <td>
                                        {{i.Zone}}
                                    </td>
                                    <td>
                                        <i title="check for assign work location" class="md-icon material-icons">&#xE869;</i>
                                        <input id="chkCustomer_{{i.tEmployeeTagId}}" 
                                               type="checkbox"
                                               data-md-icheck 
                                               class="employee-ichecked-id" 
                                               value={{i.tEmployeeTagId}}>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td></td>
                                    <td> <span><h1> {{EmplyeesLists.length?EmplyeesLists.length:0}}</h1></span> </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-2">
                            <div class="uk-form-row">
                                <div class="uk-grid" data-uk-grid-margin>
                                    <div class="uk-width-medium-1-2">
                                        <form id="formzonecollection" enctype="multipart/form-data" role="form">
                                            <select id="mZoneId" name="mZoneId" multiple>
                                                <option value="">Select Zone</option>
                                            </select>
                                            <span class="uk-form-help-block">
                                                <strong>Zone</strong>
                                            </span>
                                        </form>
                                    </div>
                                    <div class="uk-width-medium-1-2">
                                        <div class="uk-input-group">
                                            <input id="mShiftId" class="md-btn md-btn-wave waves-effect waves-button" name="mShiftId" ng-model="mShiftId" required placeholder="Select Shift" />
                                            <span class="uk-form-help-block"><b>Shift</b></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="uk-width-medium-1-2">
                            <div class="uk-grid" data-uk-grid-margin>
                                <div class="uk-width-medium-1-2">
                                    <div class="uk-input-group">
                                        <button title="Submit" type="button" ng-click="submitworkList()"
                                                class="md-btn md-btn-primary">
                                            {{loading ? loading : 'Submit'}}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot
{
    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
    <script src="~/Scripts/HexaAgular/AssignWork.js"></script>
}