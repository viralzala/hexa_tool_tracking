<div id="page_content_inner" ng-controller="BarChartReportCtrl">

    <h3 class="heading_a">Analysis Report</h3><br />



    <form id="_formColl">
        <div class="uk-grid" data-uk-grid-margin>
            <div class="uk-width-medium-5-10">
                <div class="scrum_task critical">
                    <h3 class="scrum_task_title">Note:</h3>
                    <p class="scrum_task_description">click on compartment to filter it compartment wise</p>
                </div>
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-grid">
                            <div class="uk-width-large-1-3 uk-width-medium-1-1">
                                <div class="uk-input-group">
                                    <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                    <label for="kUI_datetimepicker_range_start" class="uk-form-label">Start date:</label>
                                    @*<input id="kUI_datetimepicker_range_start" name="fromDate" />*@
                                    <input type="date" class="md-input label-fixed" id="dateFrom" name="fromDate" data-format="dd/MM/yyyy HH:mm:ss PP" />
                                    @*<label for="uk_dp_start"><b>Start Date</b> </label>
                                        <input class="md-input label-fixed" type="text" ng-model="fromDate" id="uk_dp_start">*@
                                </div>
                            </div>

                            <div class="uk-width-large-1-3 uk-width-1-1">
                                <div class="uk-input-group">
                                    <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                    <label for="kUI_datetimepicker_range_end" class="uk-form-label">End date:</label>
                                    @*<input id="kUI_datetimepicker_range_end" name="toDate" />*@
                                    <input class="md-input label-fixed" type="date" id="toDate" name="toDate" data-format="dd/MM/yyyy HH:mm:ss PP" />
                                    @*<label for="uk_dp_end"><b>End Date</b> </label>
                                        <input class="md-input label-fixed" type="text" ng-model="toDate" id="uk_dp_end">*@
                                </div>
                            </div>

                            <div class="uk-width-large-1-3 uk-width-medium-1-1">
                                <div class="uk-input-group">
                                    <span class="uk-input-group-addon"></span>
                                    <br />
                                    <a class="md-btn md-btn-primary md-btn-wave-light waves-effect waves-button waves-light" ng-click="SaveFormCollData()">View Report</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="uk-width-medium-3-10 uk-row-first" style="display:none">
                <div class="md-card">
                    <div class="md-card-content">
                        <span class="uk-input-group-addon"></span>
                        <br />
                        <a data-uk-modal="{target:'#mailbox_new_message'}" class="md-btn md-btn-primary md-btn-wave-light waves-effect waves-button waves-light" ng-click="GetEmployess()">View Employees</a>
                        @*<input type="button" class="md-btn md-btn-primary" ng-click="GetEmployess()" value="View Employees" />*@
                        <input type="reset" class="md-btn md-btn-primary" value="Reset" />
                    </div>
                </div>
            </div>
        </div>
    </form>


    <br />


    <div class="uk-grid uk-grid-width-medium-1-2 uk-grid-width-large-1-2" data-uk-grid-margin style="display:block;">
        <div>
            <div class="md-card">
                <div class="md-card-content">
                    @*<h4 class="heading_c uk-margin-bottom">Compartment</h4>*@
                    <div id="compWise"></div>
                </div>
            </div>
        </div>
        <div>
            <div class="md-card">
                <div class="md-card-content">
                    @*<h4 class="heading_c uk-margin-bottom">Work Category</h4>*@
                    <div id="WorkCatWise"></div>

                </div>
            </div>
        </div>
    </div>

    <div class="uk-grid uk-grid-width-medium-1-2 uk-grid-width-large-1-2" data-uk-grid-margin style="display:block;">
        <div>
            <div class="md-card">
                <div class="md-card-content">
                    @*<h4 class="heading_c uk-margin-bottom">Agency</h4>*@
