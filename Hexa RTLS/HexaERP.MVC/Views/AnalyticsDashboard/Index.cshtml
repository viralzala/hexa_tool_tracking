@{
    ViewBag.Title = "Enterprise Analytics";
    Layout = "~/Views/Shared/_Admin.cshtml";
}
@section head{
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        * { box-sizing: border-box; }
        body { background: #f5f7fa; }

        /* ===== Banner ===== */
        .an-banner {
            background: linear-gradient(135deg, #1a237e 0%, #283593 50%, #0d47a1 100%);
            color: #fff; border-radius: 16px; padding: 24px 28px; margin-bottom: 24px;
            box-shadow: 0 8px 24px rgba(26,35,126,.2); position: relative; overflow: hidden;
        }
        .an-banner::before {
            content: ''; position: absolute; top: -60%; right: -10%; width: 350px; height: 350px;
            background: rgba(255,255,255,.04); border-radius: 50%;
        }
        .an-banner .an-user { display: flex; align-items: center; gap: 14px; position: relative; z-index: 1; flex-wrap: wrap; }
        .an-banner .an-avatar {
            width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center; font-size: 24px; border: 2px solid rgba(255,255,255,.25);
        }
        .an-banner .an-greeting h1 { margin: 0; font-size: 22px; font-weight: 600; }
        .an-banner .an-greeting p { margin: 2px 0 0; opacity: .8; font-size: 13px; }
        .an-banner .an-meta { margin-left: auto; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
        .an-banner .an-meta .an-date { font-size: 13px; opacity: .9; display: flex; align-items: center; gap: 6px; }
        .an-banner .an-meta .an-badge {
            background: rgba(255,255,255,.12); padding: 5px 12px; border-radius: 20px; font-size: 12px;
            display: flex; align-items: center; gap: 6px;
        }
        .an-breadcrumb { margin-top: 10px; font-size: 12px; opacity: .7; position: relative; z-index: 1; }
        .an-breadcrumb a { color: rgba(255,255,255,.8); text-decoration: none; }
        .an-breadcrumb span { color: #fff; }

        /* ===== Cards ===== */
        .an-card {
            background: #fff; border-radius: 12px; border: 1px solid #e8e8e8;
            box-shadow: 0 2px 8px rgba(0,0,0,.04); transition: all .3s; overflow: hidden;
        }
        .an-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.08); }
        .an-card-hdr {
            padding: 14px 18px; border-bottom: 1px solid #f0f0f0;
            display: flex; align-items: center; justify-content: space-between;
        }
        .an-card-hdr h3 { margin: 0; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .an-card-hdr h3 i { color: #1a237e; font-size: 18px; }
        .an-card-body { padding: 18px; }
        .an-card-body.no-pad { padding: 0; }

        /* ===== KPI ===== */
        .kpi-grid {
            display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 24px;
        }
        @@media (max-width:1024px){ .kpi-grid { grid-template-columns: repeat(2,1fr); } }
        @@media (max-width:600px){ .kpi-grid { grid-template-columns: 1fr; } }
        .kpi-card {
            border-radius: 12px; padding: 18px; position: relative; overflow: hidden; cursor: default;
            box-shadow: 0 2px 8px rgba(0,0,0,.05); transition: all .3s;
        }
        .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }
        .kpi-card .kpi-bg {
            position: absolute; right: -8px; bottom: -8px; font-size: 56px; opacity: .08; color: #1a237e;
        }
        .kpi-card .kpi-icon {
            width: 40px; height: 40px; border-radius: 10px; display: flex;
            align-items: center; justify-content: center; margin-bottom: 10px; font-size: 20px; color: #fff;
        }
        .kpi-card .kpi-val { font-size: 26px; font-weight: 700; margin: 0; line-height: 1.2; }
        .kpi-card .kpi-lbl { font-size: 11px; color: rgba(0,0,0,.55); text-transform: uppercase; letter-spacing: .4px; font-weight: 500; margin: 2px 0 0; }
        .kpi-card .kpi-trend { font-size: 10px; margin-top: 2px; }

        .kpi-primary { background: linear-gradient(135deg,#e8eaf6,#c5cae9); }
        .kpi-primary .kpi-icon { background: linear-gradient(135deg,#1a237e,#3949ab); }
        .kpi-primary .kpi-val { color: #1a237e; }
        .kpi-success { background: linear-gradient(135deg,#e8f5e9,#c8e6c9); }
        .kpi-success .kpi-icon { background: linear-gradient(135deg,#2e7d32,#43a047); }
        .kpi-success .kpi-val { color: #2e7d32; }
        .kpi-warning { background: linear-gradient(135deg,#fff3e0,#ffe0b2); }
        .kpi-warning .kpi-icon { background: linear-gradient(135deg,#e65100,#ef6c00); }
        .kpi-warning .kpi-val { color: #e65100; }
        .kpi-danger { background: linear-gradient(135deg,#ffebee,#ffcdd2); }
        .kpi-danger .kpi-icon { background: linear-gradient(135deg,#c62828,#e53935); }
        .kpi-danger .kpi-val { color: #c62828; }
        .kpi-info { background: linear-gradient(135deg,#e1f5fe,#b3e5fc); }
        .kpi-info .kpi-icon { background: linear-gradient(135deg,#01579b,#0288d1); }
        .kpi-info .kpi-val { color: #01579b; }
        .kpi-purple { background: linear-gradient(135deg,#ede7f6,#d1c4e9); }
        .kpi-purple .kpi-icon { background: linear-gradient(135deg,#4a148c,#7b1fa2); }
        .kpi-purple .kpi-val { color: #4a148c; }
        .kpi-teal { background: linear-gradient(135deg,#e0f2f1,#b2dfdb); }
        .kpi-teal .kpi-icon { background: linear-gradient(135deg,#00695c,#00897b); }
        .kpi-teal .kpi-val { color: #00695c; }
        .kpi-amber { background: linear-gradient(135deg,#fff8e1,#ffecb3); }
        .kpi-amber .kpi-icon { background: linear-gradient(135deg,#f57f17,#fbc02d); }
        .kpi-amber .kpi-val { color: #f57f17; }
        .kpi-white { background: #fff; }
        .kpi-white .kpi-icon { background: linear-gradient(135deg,#1a237e,#3949ab); }
        .kpi-white .kpi-val { color: #1a237e; }

        /* ===== Charts ===== */
        .chart-row {
            display: grid; gap: 16px; margin-bottom: 20px;
        }
        .chart-row-2 { grid-template-columns: 1fr 1fr; }
        .chart-row-3 { grid-template-columns: 1fr 1fr 1fr; }
        .chart-row-4 { grid-template-columns: repeat(4,1fr); }
        .chart-row-main { grid-template-columns: 2fr 1fr; }
        @@media (max-width:900px){
            .chart-row-2, .chart-row-3, .chart-row-4, .chart-row-main { grid-template-columns: 1fr; }
        }

        /* ===== Tables ===== */
        .an-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .an-table thead { background: #f5f7fa; position: sticky; top: 0; z-index: 2; }
        .an-table thead th {
            padding: 10px 8px; font-weight: 600; color: #333; font-size: 10px;
            text-transform: uppercase; letter-spacing: .4px; border-bottom: 2px solid #e0e0e0; text-align: left;
            white-space: nowrap;
        }
        .an-table tbody td { padding: 8px; color: #555; border-bottom: 1px solid #f0f0f0; }
        .an-table tbody tr { transition: background .15s; }
        .an-table tbody tr:nth-child(even) { background: #fafafa; }
        .an-table tbody tr:hover { background: #e8eaf6; }

        /* ===== Progress ===== */
        .progress-item { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
        .progress-item label { font-size: 11px; font-weight: 500; min-width: 90px; color: #555; }
        .progress-bar { flex: 1; height: 8px; background: #e0e0e0; border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; border-radius: 4px; transition: width 1s ease; }
        .progress-item span { font-size: 11px; font-weight: 600; min-width: 35px; text-align: right; }

        /* ===== Activity List ===== */
        .act-list { list-style: none; padding: 0; margin: 0; }
        .act-list li {
            display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f5f5f5;
        }
        .act-list li:last-child { border-bottom: none; }
        .act-list .act-dot {
            width: 30px; height: 30px; border-radius: 8px; display: flex;
            align-items: center; justify-content: center; font-size: 14px; color: #fff; flex-shrink: 0;
        }
        .act-list .act-dot.blue { background: linear-gradient(135deg,#1a237e,#5c6bc0); }
        .act-list .act-dot.green { background: linear-gradient(135deg,#2e7d32,#66bb6a); }
        .act-list .act-dot.orange { background: linear-gradient(135deg,#e65100,#ffa726); }
        .act-list .act-dot.red { background: linear-gradient(135deg,#c62828,#ef5350); }
        .act-list .act-c { flex: 1; }
        .act-list .act-c .act-t { font-size: 12px; font-weight: 500; color: #333; }
        .act-list .act-c .act-m { font-size: 10px; color: #999; margin-top: 1px; }

        /* ===== Quick Actions ===== */
        .qactions {
            display: grid; grid-template-columns: repeat(4,1fr); gap: 8px;
        }
        @@media (max-width:600px){ .qactions { grid-template-columns: repeat(2,1fr); } }
        .qaction {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 4px; padding: 12px 6px; background: #f5f7fa; border-radius: 10px;
            border: 1px solid transparent; cursor: pointer; transition: all .25s; text-decoration: none; color: #333;
        }
        .qaction:hover {
            background: #e8eaf6; border-color: #c5cae9; transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(26,35,126,.08);
        }
        .qaction i { font-size: 22px; color: #1a237e; }
        .qaction span { font-size: 10px; font-weight: 500; text-align: center; }

        /* ===== Alert ===== */
        .alert-list { list-style: none; padding: 0; margin: 0; }
        .alert-list li {
            display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f5f5f5;
        }
        .alert-list li:last-child { border-bottom: none; }
        .alert-list .al-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .alert-list .al-dot.red { background: #e53935; }
        .alert-list .al-dot.amber { background: #ffa000; }
        .alert-list .al-c { flex: 1; }
        .alert-list .al-c .al-t { font-size: 12px; font-weight: 500; color: #333; }
        .alert-list .al-c .al-m { font-size: 10px; color: #999; }
        .alert-list .al-badge { font-size: 9px; padding: 2px 8px; border-radius: 10px; font-weight: 600; text-transform: uppercase; }
        .alert-list .al-badge.due { background: #fff3e0; color: #e65100; }

        /* ===== Section Title ===== */
        .section-title {
            font-size: 15px; font-weight: 600; color: #1a237e;
            margin: 0 0 14px; display: flex; align-items: center; gap: 8px;
        }
        .section-title i { font-size: 20px; }

        /* ===== Empty State ===== */
        .chart-placeholder {
            height: 200px; display: flex; flex-direction: column; align-items: center;
            justify-content: center; background: #fafafa; border-radius: 8px;
            border: 1px dashed #e0e0e0; color: #aaa; gap: 8px;
        }
        .chart-placeholder i { font-size: 32px; color: #ccc; }
        .chart-placeholder span { font-size: 12px; }

        /* ===== Loading ===== */
        .an-loader {
            display: flex; align-items: center; justify-content: center;
            min-height: 300px; flex-direction: column; gap: 12px; color: #999;
        }
        .an-loader .spinner {
            width: 40px; height: 40px; border: 3px solid #e0e0e0; border-top: 3px solid #1a237e;
            border-radius: 50%; animation: spin .8s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* ===== Responsive ===== */
        @@media (max-width:768px){
            .an-banner .an-user { flex-direction: column; align-items: flex-start; }
            .an-banner .an-meta { margin-left: 0; width: 100%; justify-content: flex-start; }
            .an-banner .an-greeting h1 { font-size: 18px; }
        }

        /* ===== Empty state ===== */
        .an-empty {
            text-align: center; padding: 20px; color: #aaa;
        }
        .an-empty i { font-size: 32px; margin-bottom: 6px; color: #ccc; }
        .an-empty p { margin: 0; font-size: 12px; }

        /* ===== Fade in ===== */
        .fade-in { animation: fadeIn .5s ease; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}
<div id="page_content_inner" ng-controller="AnalyticsDashboardCtrl" ng-cloak>
    <!-- Loading -->
    <div class="an-loader" ng-if="!loaded">
        <div class="spinner"></div>
        <span>Loading analytics...</span>
    </div>

    <div ng-if="loaded" class="fade-in">
        <!-- ===== Banner ===== -->
        <div class="an-banner">
            <div class="an-user">
                <div class="an-avatar"><i class="material-icons">&#xE7FD;</i></div>
                <div class="an-greeting">
                    <h1>Good {{currentDate.getHours()<12?'Morning':currentDate.getHours()<17?'Afternoon':'Evening'}}</h1>
                    <p>Welcome to Hexa Enterprise Analytics</p>
                </div>
                <div class="an-meta">
                    <div class="an-date"><i class="material-icons" style="font-size:15px">&#xE192;</i>{{currentDate | date:'EEEE, MMMM d, yyyy h:mm a'}}</div>
                    <div class="an-badge"><i class="material-icons" style="font-size:13px">&#xE88A;</i> Hexa ERP</div>
                </div>
            </div>
            <div class="an-breadcrumb"><a href="#">Home</a> / <span>Enterprise Analytics</span></div>
        </div>

        <!-- ===== KPI Grid ===== -->
        <div class="kpi-grid">
            <div class="kpi-card kpi-white"><div class="kpi-icon" style="background:linear-gradient(135deg,#1a237e,#3949ab)"><i class="material-icons">&#xE86E;</i></div><p class="kpi-val kpi-value">{{totalAssets}}</p><p class="kpi-lbl">Total Assets</p><div class="kpi-bg"><i class="material-icons">&#xE86E;</i></div></div>
            <div class="kpi-card kpi-success"><div class="kpi-icon"><i class="material-icons">&#xE86C;</i></div><p class="kpi-val kpi-value">{{activeAssets}}</p><p class="kpi-lbl">Active Assets</p><div class="kpi-bg"><i class="material-icons">&#xE86C;</i></div></div>
            <div class="kpi-card kpi-warning"><div class="kpi-icon"><i class="material-icons">&#xE2C4;</i></div><p class="kpi-val kpi-value">{{assetsIssued}}</p><p class="kpi-lbl">Assets Issued</p><div class="kpi-bg"><i class="material-icons">&#xE2C4;</i></div></div>
            <div class="kpi-card kpi-info"><div class="kpi-icon"><i class="material-icons">&#xE2C6;</i></div><p class="kpi-val kpi-value">{{assetsAvailable}}</p><p class="kpi-lbl">Assets Available</p><div class="kpi-bg"><i class="material-icons">&#xE2C6;</i></div></div>
            <div class="kpi-card kpi-purple"><div class="kpi-icon"><i class="material-icons">&#xE8B0;</i></div><p class="kpi-val kpi-value">{{calibrationDue}}</p><p class="kpi-lbl">Calibration Due</p><div class="kpi-bg"><i class="material-icons">&#xE8B0;</i></div></div>
            <div class="kpi-card kpi-amber"><div class="kpi-icon"><i class="material-icons">&#xE86C;</i></div><p class="kpi-val kpi-value">{{inspectionDue}}</p><p class="kpi-lbl">Inspection Due</p><div class="kpi-bg"><i class="material-icons">&#xE86C;</i></div></div>
            <div class="kpi-card kpi-danger"><div class="kpi-icon"><i class="material-icons">&#xE86E;</i></div><p class="kpi-val kpi-value">{{maintenanceDue}}</p><p class="kpi-lbl">Maintenance Due</p><div class="kpi-bg"><i class="material-icons">&#xE86E;</i></div></div>
            <div class="kpi-card kpi-teal"><div class="kpi-icon"><i class="material-icons">&#xE5CD;</i></div><p class="kpi-val kpi-value">{{expiredAssets}}</p><p class="kpi-lbl">Expired Assets</p><div class="kpi-bg"><i class="material-icons">&#xE5CD;</i></div></div>
        </div>

        <!-- ===== Quick Actions ===== -->
        <div class="an-card" style="margin-bottom:20px">
            <div class="an-card-hdr"><h3><i class="material-icons">&#xE80B;</i> Quick Actions</h3></div>
            <div class="an-card-body">
                <div class="qactions">
                    <a href="/AssetTag" class="qaction"><i class="material-icons">&#xE145;</i><span>Add Asset</span></a>
                    <a href="/MoreAssetDetail" class="qaction"><i class="material-icons">&#xE2C4;</i><span>Issue</span></a>
                    <a href="/MoreAssetDetail" class="qaction"><i class="material-icons">&#xE2C6;</i><span>Return</span></a>
                    <a href="/AssetCalibration" class="qaction"><i class="material-icons">&#xE8B0;</i><span>Calibration</span></a>
                    <a href="/AssetInspection" class="qaction"><i class="material-icons">&#xE86C;</i><span>Inspection</span></a>
                    <a href="/MoreAssetDetail" class="qaction"><i class="material-icons">&#xE86E;</i><span>Maintenance</span></a>
                    <a href="/AssetsReport" class="qaction"><i class="material-icons">&#xE8B0;</i><span>Reports</span></a>
                    <a href="/NewDashboard" class="qaction"><i class="material-icons">&#xE8AF;</i><span>Dashboard</span></a>
                </div>
            </div>
        </div>

        <!-- ===== Sparkline Trends Row (3 cols) ===== -->
        <div class="chart-row chart-row-3">
            <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE889;</i> Monthly Trend</h3></div><div class="an-card-body"><div id="chart-monthly-trend"></div></div></div>
            <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B1;</i> Weekly Trend</h3></div><div class="an-card-body"><div id="chart-weekly"></div></div></div>
            <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE192;</i> Yearly Trend</h3></div><div class="an-card-body"><div id="chart-yearly"></div></div></div>
        </div>

        <!-- ===== Main Content Grid (2fr left / 1fr right) ===== -->
        <div class="chart-row chart-row-main">
            <!-- Left -->
            <div>
                <!-- Primary Charts Row -->
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE889;</i> Line Chart - Asset Trend</h3></div><div class="an-card-body"><div id="chart-line"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Bar Chart - Calibrations</h3></div><div class="an-card-body"><div id="chart-bar"></div></div></div>
                </div>
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE86C;</i> Horizontal Bar - Inspections</h3></div><div class="an-card-body"><div id="chart-hbar"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE86E;</i> Area Chart - Maintenance</h3></div><div class="an-card-body"><div id="chart-area"></div></div></div>
                </div>
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE889;</i> Spline Chart</h3></div><div class="an-card-body"><div id="chart-spline"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Mixed Chart</h3></div><div class="an-card-body"><div id="chart-mixed"></div></div></div>
                </div>

                <!-- Distribution Charts (3 cols) -->
                <div class="chart-row chart-row-3">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Pie</h3></div><div class="an-card-body"><div id="chart-pie"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Donut</h3></div><div class="an-card-body"><div id="chart-donut"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Polar Area</h3></div><div class="an-card-body"><div id="chart-polar"></div></div></div>
                </div>

                <!-- Advanced Charts (3 cols) -->
                <div class="chart-row chart-row-3">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Radar</h3></div><div class="an-card-body"><div id="chart-radar"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Radial Bar</h3></div><div class="an-card-body"><div id="chart-radial"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Gauge</h3></div><div class="an-card-body"><div id="chart-gauge"></div></div></div>
                </div>

                <!-- Scatter, Bubble, Heatmap, Treemap, Funnel, Stacked, Timeline -->
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Scatter</h3></div><div class="an-card-body"><div id="chart-scatter"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Bubble</h3></div><div class="an-card-body"><div id="chart-bubble"></div></div></div>
                </div>
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Heatmap</h3></div><div class="an-card-body"><div id="chart-heatmap"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B6;</i> Treemap</h3></div><div class="an-card-body"><div id="chart-treemap"></div></div></div>
                </div>
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8AF;</i> Funnel</h3></div><div class="an-card-body"><div id="chart-funnel"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Stacked Bar</h3></div><div class="an-card-body"><div id="chart-stacked"></div></div></div>
                </div>
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE192;</i> Timeline</h3></div><div class="an-card-body"><div id="chart-timeline"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE192;</i> Calendar Heatmap</h3></div><div class="an-card-body"><div id="chart-calendar"></div></div></div>
                </div>

                <!-- Progress & Map -->
                <div class="chart-row chart-row-2">
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Progress</h3></div><div class="an-card-body"><div id="chart-progress"></div></div></div>
                    <div class="an-card"><div class="an-card-hdr"><h3><i class="material-icons">&#xE55B;</i> Map</h3></div><div class="an-card-body"><div id="chart-map"></div></div></div>
                </div>

                <!-- Recent Transactions Table -->
                <div class="an-card" style="margin-bottom:20px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Recent Transactions</h3><a href="#" class="an-link" style="font-size:11px;color:#1a237e">Export</a></div>
                    <div class="an-card-body no-pad">
                        <div style="overflow-x:auto">
                            <table class="an-table" ng-if="transactions.length>0">
                                <thead><tr><th>#</th><th>Issue Date</th><th>Return Date</th><th>Created By</th></tr></thead>
                                <tbody>
                                    <tr ng-repeat="t in transactions track by $index">
                                        <td>{{$index+1}}</td>
                                        <td>{{formatDate(t.IssueDate)}}</td>
                                        <td>{{formatDate(t.ReturnDate)}}</td>
                                        <td>{{t.CreatedBy}}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="an-empty" ng-if="transactions.length===0"><i class="material-icons">&#xE8B0;</i><p>No transactions</p></div>
                        </div>
                    </div>
                </div>

                <!-- Latest Assets Table -->
                <div class="an-card" style="margin-bottom:20px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE86E;</i> Latest Assets</h3></div>
                    <div class="an-card-body no-pad">
                        <div style="overflow-x:auto">
                            <table class="an-table" ng-if="latestAssets.length>0">
                                <thead><tr><th>Name</th><th>Model</th><th>Serial</th><th>By</th></tr></thead>
                                <tbody>
                                    <tr ng-repeat="a in latestAssets">
                                        <td>{{a.IteamName}}</td><td>{{a.ModelNo}}</td><td>{{a.SerialNo}}</td><td>{{a.CreatedBy}}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="an-empty" ng-if="latestAssets.length===0"><i class="material-icons">&#xE86E;</i><p>No assets</p></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar -->
            <div>
                <!-- Upcoming Alerts -->
                <div class="an-card" style="margin-bottom:16px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE7F4;</i> Upcoming Alerts</h3></div>
                    <div class="an-card-body">
                        <div ng-if="upcomingCal.length>0">
                            <p style="font-size:11px;font-weight:600;color:#e65100;margin:0 0 6px">Calibration Due</p>
                            <ul class="alert-list">
                                <li ng-repeat="c in upcomingCal">
                                    <span class="al-dot red"></span>
                                    <div class="al-c"><div class="al-t">{{c.CertificateNo||'Calibration'}}</div><div class="al-m">Due: {{formatDate(c.DueDate)}}</div></div>
                                    <span class="al-badge due">Due</span>
                                </li>
                            </ul>
                        </div>
                        <div class="an-empty" ng-if="upcomingCal.length===0"><i class="material-icons">&#xE7F4;</i><p>No alerts</p></div>
                    </div>
                </div>

                <!-- Latest Activities -->
                <div class="an-card" style="margin-bottom:16px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE889;</i> Latest Assets</h3></div>
                    <div class="an-card-body">
                        <ul class="act-list" ng-if="latestAssets.length>0">
                            <li ng-repeat="a in latestAssets.slice(0,5)">
                                <div class="act-dot blue"><i class="material-icons">&#xE86E;</i></div>
                                <div class="act-c"><div class="act-t">{{a.IteamName}}</div><div class="act-m">{{a.CreatedBy}}</div></div>
                            </li>
                        </ul>
                        <div class="an-empty" ng-if="latestAssets.length===0"><i class="material-icons">&#xE889;</i><p>No activity</p></div>
                    </div>
                </div>

                <div class="an-card" style="margin-bottom:16px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE8B0;</i> Latest Calibrations</h3></div>
                    <div class="an-card-body">
                        <ul class="act-list" ng-if="latestCal.length>0">
                            <li ng-repeat="c in latestCal.slice(0,5)">
                                <div class="act-dot orange"><i class="material-icons">&#xE8B0;</i></div>
                                <div class="act-c"><div class="act-t">{{c.CertificateNo||'N/A'}}</div><div class="act-m">{{c.CreatedBy}}</div></div>
                            </li>
                        </ul>
                        <div class="an-empty" ng-if="latestCal.length===0"><i class="material-icons">&#xE8B0;</i><p>No calibrations</p></div>
                    </div>
                </div>

                <div class="an-card" style="margin-bottom:16px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE86C;</i> Latest Inspections</h3></div>
                    <div class="an-card-body">
                        <ul class="act-list" ng-if="latestInsp.length>0">
                            <li ng-repeat="i in latestInsp.slice(0,5)">
                                <div class="act-dot green"><i class="material-icons">&#xE86C;</i></div>
                                <div class="act-c"><div class="act-t">{{i.InspectionNo}} <span ng-if="i.Status" style="font-size:10px;color:#e65100">{{i.Status}}</span></div><div class="act-m">{{i.CreatedBy}}</div></div>
                            </li>
                        </ul>
                        <div class="an-empty" ng-if="latestInsp.length===0"><i class="material-icons">&#xE86C;</i><p>No inspections</p></div>
                    </div>
                </div>

                <div class="an-card" style="margin-bottom:16px">
                    <div class="an-card-hdr"><h3><i class="material-icons">&#xE86E;</i> Latest Maintenance</h3></div>
                    <div class="an-card-body">
                        <ul class="act-list" ng-if="latestMaint.length>0">
                            <li ng-repeat="m in latestMaint.slice(0,5)">
                                <div class="act-dot red"><i class="material-icons">&#xE86E;</i></div>
                                <div class="act-c"><div class="act-t">{{m.Title}}</div><div class="act-m">{{m.CreatedBy}} - &#8377;{{m.Cost}}</div></div>
                            </li>
                        </ul>
                        <div class="an-empty" ng-if="latestMaint.length===0"><i class="material-icons">&#xE86E;</i><p>No maintenance</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section foot{
    <script src="~/Scripts/HexaAgular/AnalyticsDashboard.js"></script>
}