
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Site.cshtml";
}


@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div id="page_content">
    <div id="page_content_inner">
        <h3 class="heading_b uk-margin-bottom">Window Management</h3>
        <div class="md-card">
            <div class="md-card-content large-padding">
                <form class="uk-form-stacked" enctype="multipart/form-data" name="formdataforwindowmanagement" id="formdataforwindowmanagement">
                    <div class="uk-grid" data-uk-grid-margin>

                        <div class="parsley-row" hidden="hidden">
                            <input type="text" name="WindowIDFOREDITINGHIDDEN" id="WindowIDFOREDITINGHIDDENid" class="md-input" />
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label class="uk-form-label" for="moduleID">Modules<span class="req">*</span></label>
                                <input id="moduleIDid" name="moduleID" required placeholder="Select Module..." class="uk-form-width-medium" />
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="Modulename">Menu Name<span class="req">*</span></label>
                                <input type="text" value="" name="Menuname" id="Menunameid" value="" required class="md-input label-fixed" />
                            </div>
                        </div>

                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="ModuleDescription">Menu Description<span class="req">*</span></label>
                                <input type="text" value="" id="Descriptionid" name="Description" class="md-input label-fixed" />
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="Pagename">Page Name<span class="req">*</span></label>
                                <input type="text" id="PageNameid" required value="" name="PageName" required class="md-input label-fixed" />
                            </div>
                        </div>

                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="MenuUrl">Menu URL<span class="req">*</span></label>
                                <input type="text" value="" required id="MenuUrlid" name="MenuUrl" class="md-input label-fixed" />
                            </div>
                        </div>
                        <div class="uk-width-1-1">
                            <button type="button" class="md-btn md-btn-primary" id="btnsave" value="Submit" onclick="SaveWindow()">Submit</button>                            
                            <input type="button" class="md-btn md-btn-primary" id="btnupdate" value="Update" onclick="UpdateWindow()" />
                            <input type="button" class="md-btn md-btn-primary" id="btnCancel" value="Cancel" onclick="CancelWindow()" />

                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="md-card uk-margin-medium-bottom">
            <div class="md-card-content">
                <div class="uk-overflow-container">
                    <table id="example1" class="uk-table uk-table-nowrap table_check">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Module Name</th>
                                <th>Menu Name</th>
                                <th>Page Name</th>
                                <th>Action(s)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>


                    </table>


                </div>
            </div>
        </div>
    </div>
    
</div>

@section foot
{
    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/AppJs/UserManagement/WindowMgmt.js"></script>

    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
}