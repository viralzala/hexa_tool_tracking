@{
    /**/

    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        Layout = "~/Views/Shared/_Admin.cshtml";
    }
    else
    {
        Response.Redirect("/AppUser");
    }
}

@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div ng-controller="PutAwaySMTBinCtrl">
    <div id="page_content">
        <div id="page_content_inner">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "resetForm", @name = "resetForm" }))
            {
                <h3 class="heading_b uk-margin-bottom">Bin IN</h3>
                <div class="uk-grid" data-uk-grid-margin>
                    <div class="uk-width-large-8-10 uk-row-first">
                        <div class="md-card">
                            <div class="md-card-content">
                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-1-3">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <b>
                                                        Employee ID
                                                    </b>
                                                </span>
                                                <input type="text"
                                                       required
                                                       title="Scan Employee ID"
                                                       placeholder="Scan Employee ID"
                                                       class="md-input label-fixed"
                                                       focus-on="ModifiedBy"
                                                       name="ModifiedBy"
                                                       id="ModifiedBy"
                                                       ng-model="ModifiedBy" />
                                            </div>
                                        </div>
                                        <div class="uk-width-1-3">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <i class="uk-icon-barcode"></i>
                                                    <b>
                                                        Bin Ble
                                                    </b>
                                                </span>
                                                <input type="text" title="Scan Bin Ble" required placeholder="Scan Bin Ble" class="md-input label-fixed" name="RFID" id="RFID" ng-model="RFID" />
                                            </div>
                                        </div>
                                        <div class="uk-width-1-3">
                                            <div class="parsley-row">
                                                <hr />
                                                <button title="Submit"
                                                        type="button"
                                                        ng-click="GetBinIn()"
                                                        class="md-btn md-btn-primary">
                                                    {{loading ? loading : 'Get Data'}}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-medium-1-1 uk-row-first">
                                            <div class="uk-overflow-container">
                                                <table id="example1" class="uk-table uk-table-nowrap table_check">
                                                    <thead>
                                                        <tr>
                                                            <th style="display:none"></th>
                                                            <th>Shelf Name</th>
                                                            <th><b>Ble Tag</b></th>
                                                            <th> <b> Part Number</b></th>
                                                            <th><b>Qty</b></th>
                                                            <th><b>Pro Date</b></th>
                                                            <th><b>Serial/Lot No</b></th>
                                                            <th><b>Status</b></th>
                                                            <th><b>Location</b></th>
                                                            <th><b>Created DateTime</b></th>
                                                            <th><b>Timestamp</b></th>
                                                            <th><b>Created By</b></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td style="display:none">{{BinInfo.mSMTProductId}}</td>
                                                            <td ng-if="BinInfo.ShelfName != NULL" class="uk-text-nowrap" style="background:#02490b">
                                                                <p class="uk-text-contrast uk-margin-remove" style="font-size:xx-large">
                                                                    {{BinInfo.ShelfName}}
                                                                </p>
                                                            </td>
                                                            <td>{{BinInfo.Ble}}</td>
                                                            <td>{{BinInfo.PartNumber}}</td>
                                                            <td>{{BinInfo.Quantity}}</td>
                                                            <td>{{BinInfo.DateAndTime | jsonDate:'dd MMMM yy'}}</td>
                                                            <td>{{BinInfo.SerialNumber}}</td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary"> {{BinInfo.Status}}</span>
                                                            </td>
                                                            <td>{{BinInfo.Zone}}</td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary">
                                                                    {{BinInfo.CreatedDate | jsonDate:"dd MMMM yyyy"}}
                                                                </span>

                                                            </td>
                                                            <td>
                                                                <span class="heading_c uk-margin-bottom sub-heading uk-badge uk-badge-primary">
                                                                    {{BinInfo.CreatedDate | jsonDate: "hh:mm a"}}
                                                                </span>

                                                            </td>
                                                            <td>
                                                                <span class="uk-badge uk-badge-warning"> {{BinInfo.CreatedBy}}</span>
                                                            </td>

                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="10"></td>
                                                            <td>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uk-width-large-2-10 hidden-print">
                        <div class="md-card">
                            <div class="scrum_task critical">
                                <h3 class="scrum_task_title">Note:</h3>
                                <p class="scrum_task_description">Put curser on textbox and scan QR Code</p>
                            </div>
                            <div class="md-card-content">
                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-1-1">
                                            <div class="parsley-row">
                                                <span class="uk-form-help-block">
                                                    <i class="uk-icon-barcode"></i>
                                                    <b>
                                                        Scan Shelf Barcode
                                                    </b>
                                                </span>
                                                <input type="text" required class="md-input label-fixed" focus-on="ReaderNo" name="ReaderNo" id="ReaderNo" ng-model="ReaderNo" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="uk-form-row">
                                    <div class="uk-grid" data-uk-grid-margin="">
                                        <div class="uk-width-medium-1-1 uk-row-first">
                                            <div class="uk-input-group">
                                                <div class="timeline">
                                                    <div class="timeline_item">
                                                        @*<div class="timeline_icon">
                        <i class="uk-icon-location-arrow md-48"> </i>
                    </div>*@
                                                        <input type="hidden" id="mZoneId" />
                                                        @*<div class="uk-badge" id="Zone">
                    </div>*@
                                                        <div class="timeline_content"> <h1 id="ShelfName"></h1></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="uk-input-group">
                                                <hr />
                                                <div class="uk-input-group">
                                                    <button title="Submit"
                                                            type="button"
                                                            ng-click="SubmitBinIn()"
                                                            class="md-btn md-btn-primary">
                                                        {{loading ? loading : 'Submit'}}
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                       
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section foot
{

    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>

    <script src="~/Scripts/HexaAgular/SMT/PutAwaySMTBin.js"></script>

    @*<script type="text/javascript">
            $(function () {
                document.getElementById('ReaderNo').focus();
            });

        </script>*@

}