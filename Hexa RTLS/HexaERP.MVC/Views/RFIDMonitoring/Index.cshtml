
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section head
{
    <!-- additional styles for plugins -->
    <!-- kendo UI -->

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css")"
          rel="stylesheet" type="text/css" media="all" />


    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.material.min.css")"
          rel="stylesheet" type="text/css" media="all" id="kendoCSS" />


    <link href="../Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="../Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />

    @*@Scripts.Render("~/bundles/AngularJS")
        @Scripts.Render("~/bundles/AngularJSTranslate")*@
}

<div id="page_content_inner" ng-controller="RFIDMonotoringCtrl">

    <h3 class="heading_b uk-margin-bottom" ng-bind="'MonitorTools'|translate"></h3>
    <div class="uk-grid" data-uk-grid-margin>
        <div class="uk-width-medium-1-3">
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-large-1-1">
                            <div class="uk-input-group">
                                <div class="md-input-wrapper">
                                    @*<label>IP Address</label>*@
                                    <input type="text" id="ReaderIp" ng-model="ReaderIp" placeholder="{{'IPAddress'|translate}}" name="ReaderIp"><span class="md-input-bar "></span>
                                </div>
                                <span class="uk-input-group-addon">
                                    <a class="md-btn md-btn-primary md-btn-small" ng-click="StartReader()"><i class="material-icons"></i></a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="uk-width-medium-1-3">
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-2 parsley-row">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon">
                                    <label for="product_edit_sku_control" ng-bind="'Stop'|translate"></label>
                                </span>
                                <a ng-click="StopReader()" class="md-btn md-btn-primary md-btn-small"><i class="material-icons">&#xE036;</i></a>
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2 parsley-row">
                            <div class="uk-input-group">
                                <span class="uk-input-group-addon">
                                    <label for="product_edit_sku_control" ng-bind="'ClearData'|translate"></label>
                                </span>
                                <a ng-click="ClearData()" class="md-btn md-btn-primary md-btn-small"><i class="material-icons">&#xE14C;</i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="uk-width-medium-1-3">
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-1 parsley-row">
                            <label for="contact_list_search" ng-bind="'ReaderStatus'|translate"></label>
                            <div class="uk-input-group">
                                <span>{{lblMsg.Message}} <h2> {{lastTracked | date:'dd MMMM HH:MM:SS'}}</h2></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="uk-grid uk-grid-width-large-1-4 uk-grid-width-medium-1-2 uk-grid-medium uk-sortable sortable-handler hierarchical_show" data-uk-sortable data-uk-grid-margin>
        <div>
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-float-right uk-margin-top uk-margin-small-right"><span class="peity_visitors peity_data"></span></div>
                    <div class="row uk-grid">
                        <div class="uk-width-medium-1-2">
                            <span class="uk-text-muted uk-text-small">Total Inventory</span>
                            <h1><span class="uk-text-success">{{InvTotal.length}}</span></h1>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <span class="uk-text-muted uk-text-small"><b> {{CurrentDate | date:'dd MMMM'}}</b> Scaned</span>
                            <h1><span class="uk-text-success">{{ScanedInv.length}}</span></h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div>
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-float-right uk-margin-top uk-margin-small-right"><span class="peity_visitors peity_data"></span></div>
                    <div class="row uk-grid">
                        <div class="uk-width-medium-1-1">
                            <span class="uk-text-muted uk-text-small">Monitor</span>
                            <h1><span class="uk-text-warning">{{MonitorData.length}}</span></h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-float-right uk-margin-top uk-margin-small-right"><span class="peity_visitors peity_data"></span></div>
                    <div class="row uk-grid">
                        <div class="uk-width-large-1-1">
                            <span class="uk-text-muted uk-text-small">Missing From Inventory</span>
                            <h1><span class="uk-text-danger">{{(InvTotal.length - MonitorData.length)}}</span></h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-float-right uk-margin-top uk-margin-small-right"><span class="peity_visitors peity_data"></span></div>
                    <div class="row uk-grid">
                        <div class="uk-width-large-1-1">
                            <span class="uk-text-muted uk-text-small">Missing from Scaned Inventory. <b> {{CurrentDate | date:'dd MMMM'}}</b> </span>
                            <h1><span class="uk-text-danger">{{(ScanedInv.length - MonitorData.length)}}</span></h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        @*<div>
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-float-right uk-margin-top uk-margin-small-right"><span class="peity_live peity_data"></span></div>
                        <span class="uk-text-muted uk-text-small"></span>
                        <div class="uk-width-medium-1-1">
                            <div class="uk-input-group">
                                <div class="md-input-wrapper">
                                    <input type="text" ng-model="DisTance" placeholder="Km" class="md-input" name="DisTance"><span class="md-input-bar "></span>
                                </div>
                                <span class="uk-input-group-addon">
                                    <a class="md-btn md-btn-primary md-btn-small" ng-click="GetSpeedList()">View</a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>*@
    </div>

    <div class="uk-grid" data-uk-grid-margin="" data-uk-grid-match="{target:'.md-card-content'}" style="display:none;">
        <div class="uk-width-medium-1-2 uk-row-first">
            <h6 class="heading_b uk-margin-bottom">Monitor Data</h6>
            <div class="md-card">
                <div class="md-card-content">
                    <div class="uk-overflow-container">
                        <table class="uk-table">
                            <thead>
                                <tr>
                                    <th ng-bind="'RFID'|translate"></th>
                                    <th ng-bind="'General.Date'|translate"></th>
                                    <th>Km/Hr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="Iteam in TrackedList">
                                    <td>{{Iteam.Epc}}</td>
                                    <td>{{Iteam.SECONDs}}</td>
                                    <td>{{((DisTance*60*60) / Iteam.SECONDs) | number: 4}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>


</div>

@section foot
{
    <!-- page specific plugins -->
    <script src="../Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="../Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>

    <!-- kendo UI -->
    <script src="@Url.Content("~/Content/assets/js/kendoui_custom.min.js")"
            type="text/javascript"></script>

    <!--  kendoui functions -->
    <script src="@Url.Content("~/Content/assets/js/pages/kendoui.min.js")"
            type="text/javascript"></script>

    <script src="~/Scripts/HexaAgular/RFIDMonitoring.js"></script>
}