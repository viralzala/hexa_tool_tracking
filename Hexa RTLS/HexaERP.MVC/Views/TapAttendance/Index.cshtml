
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}



@section head
{
    <!-- htmleditor (codeMirror) -->
    <link href="@Url.Content("~/Content/bower_components/codemirror/lib/codemirror.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/kendo-ui/styles/kendo.material.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css")"
          rel="stylesheet" type="text/css" media="all" />


}

<div id="page_content_inner" ng-controller="TapAttendanceCtrl">
    <h3 class="heading_b uk-margin-bottom">Emplyee Attendance</h3>


    <div class="uk-grid" data-uk-grid-margin>

        <div class="uk-width-medium-1-2">
            <div class="uk-grid uk-grid-medium" data-uk-grid-margin="">
                <div class="uk-width-xLarge-3-10 uk-width-large-4-10 uk-row-first">
                    <div class="md-card" title="Reader Port">
                        <div class="md-card-toolbar">
                            <h3 class="md-card-toolbar-heading-text">
                                Port
                            </h3>
                        </div>
                        <div class="md-card-content" title="Last Tracked Time">
                            <select ng-model="ddlFruits" ng-options="Iteam.Key for Iteam in ListPort track by Iteam.Value"></select>
                        </div>
                    </div>
                </div>
                <div class="uk-width-xLarge-3-10 uk-width-large-4-10 uk-row-first">
                    <div class="md-card" title="Reader Port">
                        <div class="md-card-toolbar">
                            <h3 class="md-card-toolbar-heading-text">
                                In/Out
                            </h3>
                        </div>
                        <div class="md-card-content" title="In/Out">
                            <div class="uk-width-medium-1-2">
                                <div class="uk-form-row parsley-row">
                                    <span class="icheck-inline">
                                        <input type="radio" name="val_radio_gender" checked id="val_radio_male" data-md-icheck />
                                        <label for="val_radio_male" class="inline-label">In</label>
                                    </span>
                                    <span class="icheck-inline">
                                        <input type="radio" name="val_radio_gender" id="val_radio_female" data-md-icheck />
                                        <label for="val_radio_female" class="inline-label">Out</label>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="uk-width-xLarge-4-10 uk-width-large-4-10">
                    <div class="md-card" title="Reader Controll">
                        <div class="md-card-toolbar">
                            <h3 class="md-card-toolbar-heading-text">
                                Reader Controll
                            </h3>
                        </div>
                        <div class="md-card-content large-padding">
                            <div class="uk-input-group">
                                <a title="Start" ng-click="putPorts(ListPort)" class="md-btn md-btn-primary md-btn-small"><i class="material-icons"></i></a>
                                &nbsp;&nbsp; <a title="Stop" ng-click="putStop()" class="md-btn md-btn-primary md-btn-small"><i class="material-icons">&#xE036;</i></a>
                            </div>
                        </div>

                        <div class="md-card-toolbar">
                            <h3 class="md-card-toolbar-heading-text">
                                {{msg}}
                            </h3>
                        </div>
                    </div>
                </div>

            </div>
        </div>



        <div class="uk-width-medium-1-2">
            <div class="uk-grid uk-grid-medium" data-uk-grid-margin="">
                @*<div class="uk-width-xLarge-3-10 uk-width-large-4-10 uk-row-first">
                        <div class="md-card">
                            <div class="md-card-content" title="Last Tracked Time">
                                <label class="uk-display-block uk-margin-small-top" for="product_edit_active_control"><b>{{lastTracked | date:'dd MMMM HH:MM:SS'}}</b></label>
                            </div>
                        </div>
                    </div>*@
                <div class="uk-width-xLarge-12-12 uk-width-large-12-12">
                    <div class="md-card" title="Today Emplyee Attendance">
                        <div class="md-card-toolbar">
                            <h3 class="md-card-toolbar-heading-text">
                                Data
                            </h3>
                        </div>
                        <div class="md-card-content large-padding">

                            <div class="uk-input-group">
                                <div class="uk-overflow-container">
                                    <table class="uk-table">
                                        <thead>
                                            <tr>
                                                <td>SL .No</td>
                                                <td>RFID</td>
                                                <td>Date/Time</td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="it in DataList track by $index">
                                                <td>{{$index + 1}}</td>
                                                <td>{{it.RFID}}</td>
                                                <td>{{it.tDate | jsonDate: "yyyy-MM-dd HH:mm:ss"}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

