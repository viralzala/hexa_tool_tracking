
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Site.cshtml";
}


@section head
{
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div id="page_content">
    <div id="page_content_inner">
        <h3 class="heading_b uk-margin-bottom">Module Management</h3>
        <div class="md-card">
            <div class="md-card-content large-padding">
                <form id="form_validation" class="uk-form-stacked">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-2" hidden="hidden">
                            <div class="parsley-row">
                                <input type="text" name="Moduleid" class="md-input" id="ModuleIDFOREDITINGHIDDEN" />
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="moduleName">Module Name<span class="req">*</span></label>
                                <input type="text" name="moduleName" id="moduleName" required class="md-input label-fixed" />
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label for="description">Module Description</label>
                                <input type="text" name="description" required id="description" class="md-input label-fixed" />
                            </div>
                        </div>
                        <div class="uk-width-medium-1-2">
                            <div class="parsley-row">
                                <label class="uk-form-label" for="icon">Icons<span class="req">*</span></label>
                                <input id="icon" name="icon" required placeholder="Select Icon..." class="uk-form-width-medium" />
                            </div>
                        </div>
                        <div class="uk-width-1-1">

                            <button type="button" class="md-btn md-btn-primary" id="btnsave" value="Submit" onclick="SaveModuledata()">Submit</button>
                            <input type="button" class="md-btn md-btn-primary" id="btnupdate" value="Update" onclick="UpdateModule()" />
                            <input type="button" class="md-btn md-btn-primary" id="btnCancel" value="Cancel" onclick="CancelModule()" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="md-card uk-margin-medium-bottom">
            <div class="md-card-content">
                <div class="uk-overflow-container">
                    <table id="example1" class="uk-table uk-table-nowrap table_check">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Module Name</th>
                                <th>Module Description</th>
                                <th>Icon</th>
                                <th>Action(s)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot
{
    <!-- page specific plugins -->
    <script src="~/Content/bower_components/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/bower_components/datatables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/AppJs/UserManagement/ModuleManagement.js"></script>
    <script src="~/Content/assets/js/kendoui_custom.min.js"></script>
    <!--  kendoui functions -->
    <script src="~/Content/assets/js/pages/kendoui.min.js"></script>
}