    <script src="~/Content/bower_components/clndr/clndr.min.js"></script>





    <!-- countUp -->
    <script src="~/Content/bower_components/countUp.js/dist/countUp.min.js"></script>

    <!-- peity (small charts) -->
    <script src="~/Content/bower_components/peity/jquery.peity.min.js"></script>
    <!--  dashbord functions -->
    @*<script src="~/Content/assets/js/pages/dashboard.min.js"></script>*@
    <!-- page specific plugins -->
    <!-- d3 -->
    <script src="~/Content/bower_components/d3/d3.min.js"></script>
    <!-- metrics graphics (charts) -->
    <script src="~/Content/bower_components/metrics-graphics/dist/metricsgraphics.min.js"></script>
    <!-- c3.js (charts) -->
    <script src="~/Content/bower_components/c3js-chart/c3.min.js"></script>
    <script src="~/Content/bower_components/c3js-chart/c3.js"></script>
    <!--  dashbord functions -->
    <script src="~/Content/assets/js/pages/dashboard.min.js"></script>
    @*chartist*@
    <script src="~/Content/bower_components/chartist/dist/chartist.min.js"></script>
