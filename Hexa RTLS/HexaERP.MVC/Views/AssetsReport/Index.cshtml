@{
    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        Layout = "~/Views/Shared/_Admin.cshtml";
    }
    else
    {
        Response.Redirect("/AppUser");
    }
}

@section head
{
    <!-- additional styles for plugins -->
    <!-- htmleditor (codeMirror) -->
    @*<link rel="stylesheet" href="~/Content/bower_components/codemirror/lib/codemirror.css">*@
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
}


<div id="page_content_inner" ng-controller="AssetsReportCtrl">
    <h3 class="heading_a">Asset Report</h3><br />
    <form id="FormSearchEngin" role="form" enctype="multipart/form-data">
        <div class="uk-grid" data-uk-grid-margin>
            <div class="uk-width-medium-6-10">
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-grid">
                            <div class="uk-width-large-1-3 uk-width-medium-1-1">
                                <div class="uk-input-group">
                                    <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                    <label for="kUI_datetimepicker_range_start" class="uk-form-label">Start date:</label>
                                    @*<input id="kUI_datetimepicker_range_start" name="fromDate" />*@
                                    <input type="datetime-local" class="md-input label-fixed" id="dateFrom" name="fromDate" data-format="dd/MM/yyyy HH:mm:ss PP" />
                                    @*<label for="uk_dp_start"><b>Start Date</b> </label>
                                        <input class="md-input label-fixed" type="text" ng-model="fromDate" id="uk_dp_start">*@
                                </div>
                            </div>

                            <div class="uk-width-large-1-3 uk-width-1-1">
                                <div class="uk-input-group">
                                    <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-calendar"></i></span>
                                    <label for="kUI_datetimepicker_range_end" class="uk-form-label">End date:</label>
                                    @*<input id="kUI_datetimepicker_range_end" name="toDate" />*@
                                    <input class="md-input label-fixed" type="datetime-local" id="toDate" name="toDate" data-format="dd/MM/yyyy HH:mm:ss PP" />
                                    @*<label for="uk_dp_end"><b>End Date</b> </label>
                                        <input class="md-input label-fixed" type="text" ng-model="toDate" id="uk_dp_end">*@
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </div>

            <div class="uk-width-medium-3-10 uk-row-first">

            </div>
        </div>
        <div class="uk-grid" data-uk-grid-margin>

            <div class="uk-width-medium-1-4">
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="parsley-row">
                            <span class="uk-form-help-block">
                                <b>
                                    Barcode
                                </b>
                            </span>
                            <div class="md-input-wrapper md-input-filled">
                                <input type="text" class="md-input label-fixed" ng-model="Barcode" name="Barcode" id="Barcode">
                            </div>
                        </div>
                        <div class="parsley-row">
                            <span class="uk-form-help-block">
                                <b>
                                    Unique ID
                                </b>
                            </span>
                            <div class="md-input-wrapper md-input-filled">
                                <input type="text" class="md-input label-fixed" ng-model="UniqueID" name="UniqueID" id="UniqueID">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="uk-width-medium-1-4">
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-grid">
                            <div class="uk-width-large-1-1">
                                <div class="parsley-row">
                                    <span class="uk-form-help-block">
                                        <b>
                                            Asset Category
                                        </b>
                                    </span>
                                    <input id="AssetCategory"
                                           class="md-btn md-btn-wave waves-effect waves-button"
                                           name="AssetCategory"
                                           ng-model="AssetCategory"
                                           placeholder="Select Category" />
                                </div>
                            </div>
                        </div>
                        <div class="uk-grid">
                            <div class="uk-width-large-1-1">
                                <div class="parsley-row">
                                    <span class="uk-form-help-block">
                                        <b>
                                            Asset Sub Category
                                        </b>
                                    </span>
                                    <input id="AssetSubCategory"
                                           class="md-btn md-btn-wave waves-effect waves-button"
                                           name="AssetSubCategory"
                                           ng-model="AssetSubCategory"
                                           placeholder="Select Sub Category" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="uk-width-medium-1-4">
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-grid">
                            <div class="uk-width-large-1-1">
                                <div class="parsley-row">
                                    <span class="uk-form-help-block">
                                        <b>
                                            Asset Type
                                        </b>
                                    </span>
                                    <input id="AssetType"
                                           class="md-btn md-btn-wave waves-effect waves-button"
                                           name="AssetType"
                                           ng-model="AssetType"
                                           placeholder="Select Asset Type" />
                                </div>
                            </div>
                        </div>
                        <div class="uk-grid">
                            <div class="uk-width-large-1-1">
                                <div class="parsley-row">
                                    <span class="uk-form-help-block">
                                        <b>
                                            Vendor
                                        </b>
                                    </span>
                                    <input id="Vendor"
                                           class="md-btn md-btn-wave waves-effect waves-button"
                                           name="Vendor"
                                           ng-model="Vendor"
                                           placeholder="Select Vendor" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="uk-width-medium-1-4">
                <div class="md-card">
                    <div class="md-card-content">
                        <div class="uk-form-row">
                            <div class="parsley-row">
                                <span class="uk-form-help-block"><b>Location</b></span>
                                <input class="md-btn md-btn-wave waves-effect waves-button"
                                       id="mSiteMasterId"
                                       name="mSiteMasterId"
                                       placeholder="Select Location" />
                            </div>
                        </div>
                        <div class="uk-form-row">
                            <div class="parsley-row">
                                <span class="uk-form-help-block"><b>Zone</b></span>
                                <select id="mZoneId" name="mZoneId" class="uk-form-width-medium"></select>
                            </div>
                        </div>
                        <div class="uk-form-row">
                            <div class="parsley-row">
                                <span class="uk-form-help-block"><b>Floor</b></span>
                                <select id="mFloorMasterId" name="mFloorMasterId" class="uk-form-width-medium"></select>
                            </div>
                        </div>
                        <div class="uk-form-row">
                            <div class="parsley-row">
                                <button type="button" class="md-btn md-btn-primary uk-margin-small-top"
                                        id="formSearchEngineSubmit">
                                    Refresh
                                </button>
                                <span class="uk-form-help-block">
                                    <strong>
                                        Click Refresh to load Asset Report
                                    </strong>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*<div class="uk-grid" data-uk-grid-margin>
                <div class="uk-width-medium-2-10 uk-row-first">
                </div>
                <div class="uk-width-medium-8-10">

                </div>
            </div>*@
    </form>
    <hr />
    <div class="uk-grid" data-uk-grid-margin="">
        <div class="uk-width-1-1">
            <div class="md-card">
                <div class="md-card-content">

                    <div class="uk-grid">
                        <div class="uk-width-large-1-2 uk-row-first">
                            <div class="md-card">
                                <div class="md-card-content">
                                    <div class="uk-input-group">
                                        <span class="uk-input-group-addon">
                                            <i class="uk-icon-search"></i>
                                        </span>
                                        <div class="md-input-wrapper md-input-filled">
                                            <label for="product_edit_quantity_control"><strong> Filter</strong></label>
                                            <input type="text" class="md-input label-fixed" ng-model="assetFilter">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="uk-width-large-1-2">
                            <div class="md-card">
                                <div class="md-card-content">
                                    <div class="scrum_task critical">
                                        <a class="md-btn md-btn-flat scrum_task_title" href="@Url.Action("ExportExcelAsset","AssetsReport")">Excel Export</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="printablediv">
                        <div class="scrum_task success">
                            <strong> Total Assets : <h1>{{totalRecords}}</h1></strong>
                        </div>
                        <div class="uk-overflow-container">
                            <div class="table-responsive">
                                <table class="uk-table uk-table-hover" cellspacing="0" width="100%">
                                    <thead>
                                        <tr class="uk-text-nowrap">
                                            <th><strong>Asset Name</strong></th>
                                            <th><strong>Asset Number / Asset Tag</strong></th>
                                            <th><strong>Category</strong></th>
                                            <th><strong>Asset Type</strong></th>
                                            <th><strong>Vendor</strong></th>
                                            <th><strong>Status</strong></th>
                                            <th><strong>Zone</strong></th>
                                            <th><strong>Floor</strong></th>
                                            <th><strong>Current Location</strong></th>
                                            <th><strong>Last Updated</strong></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="Iteam in AssetReportList | filter : assetFilter track by $index">
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    <strong>{{ Iteam.IteamName }}</strong>
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.AssetID }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.Category }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.AssetType }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.Vendor }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.Status }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.Zone }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.Floor }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.CurrentLocation }}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <span class="uk-text-small">
                                                    {{ Iteam.ModifiedDate | jsonDate :'dd-MMM-yy hh:mm a'}}
                                                </span>
                                            </td>
                                            <td class="uk-table-nowrap">
                                                <a data-uk-tooltip="{cls:'uk-tooltip-small',pos:'bottom'}" title="Click here to view asset history" data-uk-modal="{target:'#Asset_moreDetails'}" ng-click="AssetMoreDetail(Iteam.tAssetTagId)">
                                                    View History
                                                </a>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>
                                                <span><h1> {{AssetReportList.length?AssetReportList.length:0}}</h1></span>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <ul class="uk-pagination uk-margin-medium-top uk-margin-medium-bottom">
                            <li ng-if="currentPage <= 1">
                                <a class="uk-disabled">
                                    <span>
                                        <i class="uk-icon-angle-double-left">
                                        </i>
                                    </span>
                                </a>
                            </li>
                            <li ng-if="currentPage > 1">
                                <a ng-click="pageChanged(currentPage - 1,'ASSETREPORT')">
                                    <span>
                                        <i class="uk-icon-angle-double-left">
                                        </i>
                                    </span>
                                </a>
                            </li>
                            <li class="uk-active">
                                <a ng-click="pageChanged(currentPage,'ASSETREPORT')">
                                    <span>
                                        {{currentPage}}
                                    </span>
                                </a>
                            </li>
                            <li ng-if="totalRecords > 10">
                                <a ng-click="pageChanged(currentPage + 1,'ASSETREPORT')">
                                    {{currentPage + 1}}
                                </a>
                            </li>
                            <li ng-if="totalRecords > 20">
                                <a ng-click="pageChanged(currentPage + 2,'ASSETREPORT')">
                                    {{currentPage + 2}}
                                </a>
                            </li>
                            <li><span>&hellip;</span></li>
                            <li>
                                <a ng-click="pageChanged(currentPage + 1,'ASSETREPORT')">
                                    <i class="uk-icon-angle-double-right">
                                    </i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="uk-modal uk-modal-card-fullscreen" id="Asset_moreDetails">
        <div class="uk-modal-dialog uk-modal-dialog-blank">
            <div class="md-card uk-height-viewport">
                <div class="md-card-toolbar">
                    <span class="md-icon material-icons uk-modal-close">
                        <i class="md-icon material-icons md-card-overlay-toggler"></i>
                    </span>
                    <h3 class="md-card-toolbar-heading-text">
                        <strong> Asset Tracking History</strong>
                    </h3>
                </div>
                <div class="md-card-content">

                    <div class="md-card uk-margin-medium-bottom">
                        <div class="md-card-content">
                            <div class="uk-overflow-container">
                                <div class="table-responsive">
                                    <table class="uk-table" cellspacing="0" width="100%" id="tblHistory">
                                        <thead>
                                            <tr class="uk-text-nowrap">
                                                <th><b>DateTime</b></th>
                                                <th><b>Record Changes</b></th>
                                                <th><b>Action</b></th>
                                                <th><b>Record Owner</b></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="Iteam in AssetDetailList | filter : assetFilter track by $index">
                                                <td>
                                                    <span class="uk-width-2-10  uk-text-small">
                                                        {{Iteam.DmlTimestamp | jsonDate :'dd-MMM-yy hh:mm a'}}
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="md-list-content">
                                                        <div ng-repeat="(k,v) in Iteam.outerChange">
                                                            <div class="uk-text-small uk-text-muted">{{v}}</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="uk-text-small">
                                                    <span class="uk-text-small uk-badge uk-notify-message-primary wrap_controls">
                                                        {{ Iteam.DmlType }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="uk-text-small uk-badge uk-notify-message-info wrap_controls">
                                                        {{ Iteam.DmlCreatedBy }}
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="6">
                                                    <ul class="uk-pagination uk-margin-medium-top uk-margin-medium-bottom">
                                                        <li ng-if="currentPage <= 1">
                                                            <a class="uk-disabled">
                                                                <span>
                                                                    <i class="uk-icon-angle-double-left">
                                                                    </i>
                                                                </span>
                                                            </a>
                                                        </li>
                                                        <li ng-if="currentPage > 1">
                                                            <a ng-click="pageChanged(currentPage - 1,'ASSETMOREDETAILREPORT')">
                                                                <span>
                                                                    <i class="uk-icon-angle-double-left">
                                                                    </i>
                                                                </span>
                                                            </a>
                                                        </li>
                                                        <li class="uk-active">
                                                            <a ng-click="pageChanged(currentPage,'ASSETMOREDETAILREPORT')">
                                                                <span>
                                                                    {{currentPage}}
                                                                </span>
                                                            </a>
                                                        </li>
                                                        <li ng-if="TotalAuditRecord > 10">
                                                            <a ng-click="pageChanged(currentPage + 1,'ASSETMOREDETAILREPORT')">
                                                                {{currentPage + 1}}
                                                            </a>
                                                        </li>
                                                        <li ng-if="TotalAuditRecord > 20">
                                                            <a ng-click="pageChanged(currentPage + 2,'ASSETMOREDETAILREPORT')">
                                                                {{currentPage + 2}}
                                                            </a>
                                                        </li>
                                                        <li><span>&hellip;</span></li>
                                                        <li>
                                                            <a ng-click="pageChanged(currentPage + 1,'ASSETMOREDETAILREPORT')">
                                                                <i class="uk-icon-angle-double-right">
                                                                </i>
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



@section foot
{

    <!-- kendo UI -->
    <script src="@Url.Content("~/Content/assets/js/kendoui_custom.min.js")"
            type="text/javascript"></script>

    <!--  kendoui functions -->
    <script src="@Url.Content("~/Content/assets/js/pages/kendoui.min.js")"
            type="text/javascript"></script>

    <script>
        function printDiv(divID) {
            var divElements = document.getElementById(divID).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = "<html><head><title></title></head><body>" + divElements + "</body>";
            window.print();
            document.body.innerHTML = oldPage;
        }

        function printDiv(divID) {
            var divElements = document.getElementById(divID).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = "<html><head><title></title></head><body>" + divElements + "</body>";
            window.print();
            document.body.innerHTML = oldPage;
        }
    </script>

    <!-- additional styles for plugins -->
    <!-- kendo UI -->
    <script src="~/Scripts/HexaAgular/AssetsReport.js"></script>
