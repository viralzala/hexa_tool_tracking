                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.IteamName || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
