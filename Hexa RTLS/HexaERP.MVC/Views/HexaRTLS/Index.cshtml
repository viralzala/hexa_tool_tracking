@section head
{
    <!-- htmleditor (codeMirror) -->
    <link href="@Url.Content("~/Content/bower_components/codemirror/lib/codemirror.css")"
          rel="stylesheet" type="text/css" media="all" />

    <!-- kendo UI -->
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css")"
          rel="stylesheet" type="text/css" media="all" />

    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css")"
          rel="stylesheet" type="text/css" media="all" />
    <style>
        /* FIXED: Warehouse-style grid layout for shelves */
        .shelf-grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 12px;
            padding: 16px 0;
        }

        .shelf-card {
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 1px 3px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.24);
            padding: 16px 8px;
            text-align: center;
            cursor: pointer;
            transition: all 280ms cubic-bezier(.4,0,.2,1);
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .shelf-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,.19), 0 6px 6px rgba(0,0,0,.23);
            transform: translateY(-2px);
        }

        .shelf-badge {
            font-size: 13px;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 2px;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        .shelf-active {
            background: #7cb342;
        }

        .shelf-inactive {
            background: #e53935;
        }

        /* Responsive adjustments */
        @@media only screen and (max-width: 767px) {
            .shelf-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                gap: 8px;
            }

            .shelf-card {
                padding: 12px 6px;
                min-height: 60px;
            }

            .shelf-badge {
                font-size: 11px;
                padding: 4px 8px;
            }
        }

        @@media only screen and (min-width: 768px) and (max-width: 1219px) {
            .shelf-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
                gap: 10px;
            }
        }

        @@media only screen and (min-width: 1220px) {
            .shelf-grid-container {
                grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                gap: 12px;
            }
        }

        /* Hide UIkit grid no results message by default */
        .grid_no_results {
            display: none !important;
        }

        .grid_no_results.visible {
            display: block !important;
        }
    </style>
}

<div ng-controller="HexaRTLSCtrl">

    <div id="page_content">
        <div id="page_content_inner">


            <div class="scrum_task critical">
                <p class="scrum_task_description"><b> Note:</b> click on asset/employee name to get details about it</p>
            </div>
            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="uk-grid" data-uk-grid-margin>
                        <div class="uk-width-medium-1-1">


                            <div class="uk-vertical-align">
                                <div class="uk-vertical-align-middle">
                                   <ul id="contact_list_filter" class="uk-subnav uk-subnav-pill uk-margin-remove">

                                <li class="uk-active" data-uk-filter="">
                                    <a href="#">All</a>
                                </li>

                                <li ng-repeat="Iteam in Location"
                                    data-uk-filter="{{Iteam.mZoneId}}">
                                    <a ng-click="ShowProduct(Iteam)" href="#">
                                        {{Iteam.Zone}}
                                    </a>
                                </li>

                                <li title="Safety report click here download excel">
                                    <a href="@Url.Action("SafetyExportExcelAsync","EmployeeTrackSummary")">
                                        Safety report
                                    </a>
                                </li>

                            </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="heading_b uk-text-center grid_no_results">No Locations found</h3>

        <!-- FIXED: Removed UIkit grid classes that conflict with AngularJS, using custom CSS grid instead -->
        <div id="contact_list" class="shelf-grid-container hierarchical_show">

            <!-- FIXED: Each shelf is now a grid item in warehouse-style layout -->
            <div class="shelf-card"
                 ng-repeat="task in Shelf"
                 data-uk-filter="{{task.mZoneId}}"
                 ng-click="ShowProduct(task)">

                <!-- FIXED: Badge styling with proper active/inactive states -->
                <div class="shelf-badge {{task.IsAction == false ?
                    'shelf-active' :
                    'shelf-inactive'}}"
                     title="{{task.PartNumber}}">

                    {{task.ShelfName}}

                </div>

            </div>

        </div>
    </div>
</div>

