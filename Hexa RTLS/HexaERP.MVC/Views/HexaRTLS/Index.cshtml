                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.AssetID || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
                        <span style="font-weight: 600; color: #616161;">RFID:</span>
                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.RFID || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
                        <span style="font-weight: 600; color: #616161;">Location:</span>
                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.ZoneName || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
                        <span style="font-weight: 600; color: #616161;">Floor:</span>
                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.FloorName || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
                        <span style="font-weight: 600; color: #616161;">Room:</span>
                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.RoomName || 'N/A'}}</span>
                    </div>
                    
                    <div class="asset-info-item" style="display: flex; justify-content: space-between; padding: 10px; background: #f5f5f5; border-radius: 6px;">
                        <span style="font-weight: 600; color: #616161;">Last Updated:</span>
                        <span style="color: #212121; font-weight: 500;">{{assetPopupData.tDate | jsonDate: "dd-MMM-yyyy HH:mm:ss"}}</span>
                    </div>
                </div>

                <div style="margin-top: 20px; text-align: center;">
                    <button class="md-btn md-btn-primary" ng-click="closeAssetPopup()">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

