@{
    /**/
    ViewBag.Title = "Tracking Dashboard";

    if (Session["SortCode"] != null)
    {
        Layout = "~/Views/Shared/_Admin.cshtml";
    }
    else
    {
        
    }
}

@section head
{
    <link href="@Url.Content("~/Content/bower_components/codemirror/lib/codemirror.css")"
          rel="stylesheet" type="text/css" media="all" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.common-material.min.css" rel="stylesheet" />
    <link href="~/Content/bower_components/kendo-ui/styles/kendo.material.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/jquery.dataTables.min.css")"
          rel="stylesheet" type="text/css" media="all" />
    <link href="@Url.Content("~/Content/bower_components/datatables/media/css/dataTables.bootstrap.css")"
          rel="stylesheet" type="text/css" media="all" />
    <style>
        /* ==========================================
         * TRACKING DASHBOARD - 3 STEP UI
         * STEP 1: Location Filter Buttons
         * STEP 2: Floor Cards
         * STEP 3: Assets List
         * ========================================== */

        /* ---- STEP 1: Location Filter Buttons ---- */
        .location-filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 4px 0;
        }

        .location-filter-bar .filter-btn {
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid rgba(0,0,0,.12);
            background: #fff;
            color: #424242;
            text-transform: uppercase;
        }

        .location-filter-bar .filter-btn:hover {
            background: #e3f2fd;
            border-color: #2196f3;
        }

        .location-filter-bar .filter-btn.active {
            background: #1976d2;
            color: #fff;
            border-color: #1976d2;
        }

        /* ---- STEP 2: Floor Cards ---- */
        .floor-cards-container {
            display: none; /* Hidden until a location is selected */
        }

        .floor-cards-container.active {
            display: block;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0 16px;
            padding: 12px 16px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 1px 3px rgba(0,0,0,.12);
        }

        .section-header .back-btn {
            background: #1976d2;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 6px 16px;
            font-size: 13px;
            cursor: pointer;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .section-header .back-btn:hover {
            background: #1565c0;
            text-decoration: none;
            color: #fff;
        }

        .section-header .back-btn .material-icons {
            font-size: 18px;
            color: #fff;
        }

        .section-header .section-title {
            font-size: 20px;
            font-weight: 500;
            margin: 0;
            flex: 1;
        }

        .section-header .section-count {
            font-size: 13px;
            color: #727272;
        }

        .floor-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .floor-card {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            cursor: pointer;
            transition: all 0.3s ease;
            height: 220px;
            background: #f5f5f5;
        }

        .floor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0,0,0,.25);
        }

        .floor-card.floor-selected {
            border: 3px solid #1976d2;
            box-shadow: 0 4px 16px rgba(25, 118, 210, 0.4);
        }

        .floor-card-bg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            pointer-events: none;
        }

        .floor-card-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent 30%, rgba(0,0,0,.75));
            color: #fff;
            padding: 48px 20px 20px;
        }

        .floor-card-overlay .floor-name {
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 2px;
            color: #fff;
        }

        .floor-card-overlay .floor-location {
            font-size: 13px;
            opacity: .85;
            margin-bottom: 10px;
            display: block;
        }

        .floor-card-overlay .floor-stats {
            display: flex;
            gap: 20px;
            font-size: 12px;
            margin-bottom: 12px;
            align-items: center;
        }

        .floor-card-overlay .floor-stats .stat-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .floor-card-overlay .floor-stats .stat-item .material-icons {
            font-size: 16px;
            color: #fff;
        }

        .btn-view-assets {
            background: rgba(255,255,255,.2);
            color: #fff;
            border: 1px solid rgba(255,255,255,.5);
            border-radius: 6px;
            padding: 6px 20px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-transform: uppercase;
            display: inline-block;
        }

        .btn-view-assets:hover {
            background: rgba(255,255,255,.35);
            text-decoration: none;
            color: #fff;
        }

        .floor-card-overlay .last-updated {
            font-size: 11px;
            opacity: .65;
            margin-top: 6px;
        }

        /* ---- STEP 3: Assets List ---- */
        .assets-view {
            display: none;
        }

        .assets-view.active {
            display: block;
        }

        .assets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .asset-card {
            background: #fff;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,.12);
            transition: all 0.2s;
            border-left: 4px solid #4CAF50;
        }

        .asset-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.18);
            transform: translateY(-2px);
        }

        .asset-card.asset-available {
            border-left-color: #4CAF50;
        }

        .asset-card.asset-inuse {
            border-left-color: #2196f3;
        }

        .asset-card.asset-maintenance {
            border-left-color: #ff9800;
        }

        .asset-card.asset-occupied {
            border-left-color: #e53935;
        }

        .asset-name {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 4px;
            color: #212121;
        }

        .asset-code {
            font-size: 12px;
            color: #727272;
            margin-bottom: 12px;
            display: block;
        }

        .asset-details {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .asset-detail-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #616161;
            background: #f5f5f5;
            padding: 4px 12px;
            border-radius: 16px;
        }

        .asset-detail-item .material-icons {
            font-size: 14px;
        }

        .asset-detail-item .status-badge {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 4px;
        }

        .status-badge.available { background: #4CAF50; }
        .status-badge.inuse { background: #2196f3; }
        .status-badge.maintenance { background: #ff9800; }
        .status-badge.occupied { background: #e53935; }

        /* ---- NEW: Multi-Floor View Styles ---- */
        .multi-floor-view {
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .floor-map-container {
            transition: all 0.3s ease;
        }

        .floor-map-container:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.25);
        }

        .floor-map-wrapper {
            overflow: hidden;
            background: #fafafa;
        }

        .floor-map-wrapper img {
            transition: transform 0.3s ease;
        }

        .floor-map-container:hover .floor-map-wrapper img {
            transform: scale(1.02);
        }

        /* Asset Marker Animation */
        @keyframes pulse {
            0% {
                box-shadow: 0 2px 8px rgba(0,0,0,.4);
            }
            50% {
                box-shadow: 0 2px 20px rgba(244, 67, 54, 0.8);
            }
            100% {
                box-shadow: 0 2px 8px rgba(0,0,0,.4);
            }
        }

        .asset-marker {
            animation: markerAppear 0.5s ease-out;
            cursor: pointer;
        }

        @keyframes markerAppear {
            0% {
                transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }
            50% {
                transform: translate(-50%, -50%) scale(1.2);
            }
            100% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 1;
            }
        }

        .asset-marker:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        /* Floor Highlight Effect */
        .floor-highlight {
            animation: highlightPulse 2s ease-out;
            box-shadow: 0 0 0 4px rgba(33, 150, 243, 0.5);
        }

        @keyframes highlightPulse {
            0% {
                box-shadow: 0 0 0 4px rgba(33, 150, 243, 0.8);
            }
            100% {
                box-shadow: 0 0 0 4px rgba(33, 150, 243, 0);
            }
        }

        /* Search Results Panel */
        .search-results-panel {
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
        }

        .search-result-item:hover {
            background: #f5f5f5 !important;
        }

        /* ---- Shared ---- */
        .grid_no_results {
            display: none !important;
        }

        .grid_no_results.visible {
            display: block !important;
        }

        .no-data-message {
            text-align: center;
            padding: 60px 20px;
            color: #727272;
            font-size: 16px;
        }

        /* Responsive */
        @@media only screen and (max-width: 767px) {
            .floor-card {
                height: 180px;
            }
            .floor-cards-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }
            .assets-grid {
                grid-template-columns: 1fr;
            }
            .section-header {
                flex-wrap: wrap;
            }
            .location-filter-bar .filter-btn {
                padding: 6px 14px;
                font-size: 11px;
            }
        }

        @@media only screen and (min-width: 768px) and (max-width: 1219px) {
            .floor-cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .assets-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}

<div ng-controller="HexaRTLSCtrl">

    <div id="page_content">
        <div id="page_content_inner">

            <!-- Note Banner -->
            <div class="scrum_task critical">
                <p class="scrum_task_description">
                    <b>Note:</b> Select a location to view floors, then click "View Assets" to see shelf-level asset details.
                </p>
            </div>

            <!-- ============================================ -->
            <!-- STEP 1: LOCATION FILTER BUTTONS              -->
            <!-- ============================================ -->
            <div class="md-card uk-margin-medium-bottom">
                <div class="md-card-content">
                    <div class="location-filter-bar">
                        <!-- "All" button - shows all floors -->
                        <button class="filter-btn"
                                ng-class="{active: selectedLocationId == null}"
                                ng-click="selectLocation(null)">
                            All
                        </button>
                        <!-- Location buttons from API -->
                        <button class="filter-btn"
                                ng-repeat="loc in Location"
                                ng-class="{active: selectedLocationId == loc.mZoneId}"
                                ng-click="selectLocation(loc)">
                            {{loc.Zone}}
                        </button>
                        <!-- Safety report download -->
                        <button class="filter-btn"
                                title="Safety report click here download excel"
                                ng-click="downloadSafetyReport()">
                            Safety report
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============================================ -->
            <!-- ASSET SEARCH BAR                              -->
            <!-- Search assets by ID, RFID, Barcode, or Name  -->
            <!-- ============================================ -->
            <div class="md-card uk-margin-medium-bottom" ng-show="!showMultiFloorView">
                <div class="md-card-content">
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="text" 
                               ng-model="searchQuery" 
                               placeholder="Search Asset by ID, RFID, Barcode, or Name..."
                               class="md-input"
                               style="flex: 1;"
                               ng-keypress="($event.which === 13) && searchAsset()" />
                        <button class="md-btn md-btn-primary" ng-click="searchAsset()">
                            <i class="material-icons">&#xE8B6;</i> Search
                        </button>
                        <button class="md-btn md-btn-default" ng-click="clearSearch()" ng-show="showSearchResults">
                            Clear
                        </button>
                    </div>

                    <!-- Search Results Dropdown -->
                    <div class="search-results-panel" ng-show="showSearchResults && searchResults.length > 0" style="margin-top: 15px; max-height: 400px; overflow-y: auto;">
                        <div class="search-result-item" 
                             ng-repeat="asset in searchResults" 
                             style="padding: 12px; border-bottom: 1px solid #e0e0e0; cursor: pointer; transition: background 0.2s;"
                             ng-mouseenter="this.style.background='#f5f5f5'" 
                             ng-mouseleave="this.style.background='white'"
                             ng-click="locateAsset(asset)">
                            <div style="font-weight: 600; color: #212121;">{{asset.IteamName || asset.IteamCode || 'N/A'}}</div>
                            <div style="font-size: 12px; color: #727272; margin-top: 4px;">
                                <span ng-if="asset.AssetID">ID: {{asset.AssetID}} | </span>
                                <span ng-if="asset.RFID">RFID: {{asset.RFID}} | </span>
                                <span ng-if="asset.BarCode">Barcode: {{asset.BarCode}}</span>
                            </div>
                            <div style="font-size: 11px; color: #9e9e9e; margin-top: 4px;">
                                {{asset.FloorName}} | {{asset.ZoneName}} | {{asset.RoomName}}
                            </div>
                        </div>
                    </div>

                    <!-- No Search Results Message -->
                    <div class="no-data-message" ng-show="showSearchResults && searchResults.length === 0" style="margin-top: 15px;">
                        <i class="material-icons" style="font-size: 48px; color: #bdbdbd; display: block; margin-bottom: 12px;">&#xE8B0;</i>
                        No assets found matching your search.
                    </div>
                </div>
            </div>

            <!-- ============================================ -->
            <!-- STEP 2: FLOOR CARDS                          -->
            <!-- Shows floors filtered by selected location.  -->
            <!-- Each card shows: background, floor name,     -->
            <!-- location name, asset count, View button.     -->
            <!-- ============================================ -->
            <div id="floorCardsSection" class="floor-cards-container" ng-class="{active: true}">

                <div class="section-header">
                    <button class="back-btn" ng-click="resetToLocations()" ng-show="showAssetsView">
                        <i class="material-icons">&#xE5C4;</i> Back
                    </button>
                    <h3 class="section-title" ng-if="!showAssetsView">
                        {{selectedLocationName || 'All Locations'}}
                    </h3>
                    <h3 class="section-title" ng-if="showAssetsView">
                        {{selectedFloorName}}
                    </h3>
                    <span class="section-count" ng-if="!showAssetsView">
                        {{filteredFloors.length}} floors
                    </span>
                    <span class="section-count" ng-if="showAssetsView">
                        {{assetsList.length}} assets
                    </span>
                    
                    <!-- NEW: Multi-Floor View Button -->
                    <button class="md-btn md-btn-success" 
                            ng-show="!showAssetsView && !showMultiFloorView && selectedFloors.length > 0"
                            ng-click="showMultiFloorMaps()"
                            style="margin-left: auto;">
                        <i class="material-icons">&#xE1C4;</i> Show {{selectedFloors.length}} Floor{{selectedFloors.length > 1 ? 's' : ''}}
                    </button>
                </div>

                <!-- Floor Cards Grid (visible when not in asset view) -->
                <div class="floor-cards-grid" ng-show="!showAssetsView">

                    <div class="floor-card"
                         ng-repeat="floor in filteredFloors"
                         ng-click="selectFloor(floor)"
                         ng-class="{'floor-selected': isFloorSelected(floor.mFloorMasterId)}">

                        <!-- Background image for floor card -->
                        <img class="floor-card-bg"
                             src="~/Content/assets/img/4dc174f0-2c88-48f9-86ff-220d000e2f6a.jpg"
                             alt="{{floor.FloorName}}"
                             draggable="false" />

                        <!-- Selection Checkbox (top-right corner) -->
                        <div style="position: absolute; top: 12px; right: 12px; z-index: 100;">
                            <input type="checkbox" 
                                   ng-checked="isFloorSelected(floor.mFloorMasterId)"
                                   ng-click="$event.stopPropagation(); toggleFloorSelection(floor)"
                                   style="width: 20px; height: 20px; cursor: pointer; accent-color: #1976d2;"
                                   title="Select for multi-floor view" />
                        </div>

                        <!-- Overlay with floor info -->
                        <div class="floor-card-overlay">
                            <h4 class="floor-name">{{floor.FloorName}}</h4>
                            <span class="floor-location">{{floor.Zone || selectedLocationName || ''}}</span>

                            <div class="floor-stats">
                                <span class="stat-item">
                                    <i class="material-icons">&#xE227;</i>
                                    Assets: {{getFloorAssetCount(floor)}}
                                </span>
                                <span class="stat-item">
                                    <i class="material-icons">&#xE30A;</i>
                                    Floor {{floor.FloorNo}}
                                </span>
                            </div>

                            <!-- View Assets button -->
                            <a class="btn-view-assets" ng-click="$event.stopPropagation(); selectFloor(floor)">
                                View Assets
                            </a>

                            <div class="last-updated">
                                Updated: {{lastTracked}}
                            </div>
                        </div>
                    </div>

                    <!-- No floors message -->
                    <div class="no-data-message" ng-if="filteredFloors.length === 0 && !showAssetsView">
                        <i class="material-icons" style="font-size:48px;color:#bdbdbd;display:block;margin-bottom:12px;">&#xE8B0;</i>
                        No floors found for this location.
                    </div>
                </div>

                <!-- ============================================ -->
                <!-- STEP 3: ASSETS LIST                          -->
                <!-- Shows assets/shelves for selected floor.     -->
                <!-- Each item shows: name, code, status, shelf.  -->
                <!-- ============================================ -->
                <div class="assets-view" ng-class="{active: showAssetsView}">

                    <div class="assets-grid">
                        <div class="asset-card {{getAssetStatusClass(asset)}}"
                             ng-repeat="asset in assetsList">

                            <!-- FIXED: Asset Name from database tAssetTag table -->
                            <h4 class="asset-name">{{asset.IteamName || asset.IteamCode || 'N/A'}}</h4>

                            <!-- FIXED: Asset Tag/Number from database -->
                            <span class="asset-code">
                                Tag: {{asset.AssetID || asset.IteamCode || asset.BarCode || 'N/A'}}
                            </span>

                            <!-- FIXED: Asset Details from database -->
                            <div class="asset-details">
                                <!-- FIXED: Status from database IsAction property -->
                                <span class="asset-detail-item">
                                    <span class="status-badge {{getStatusClass(asset)}}"></span>
                                    {{getAssetStatus(asset)}}
                                </span>

                                <!-- FIXED: RFID tag from database -->
                                <span class="asset-detail-item" ng-if="asset.RFID">
                                    <i class="material-icons">&#xE0DA;</i>
                                    RFID: {{asset.RFID}}
                                </span>

                                <!-- FIXED: Serial Number from database -->
                                <span class="asset-detail-item" ng-if="asset.SerialNo">
                                    <i class="material-icons">&#xE873;</i>
                                    SN: {{asset.SerialNo}}
                                </span>

                                <!-- FIXED: Model No from database -->
                                <span class="asset-detail-item" ng-if="asset.ModelNo">
                                    <i class="material-icons">&#xE8B6;</i>
                                    {{asset.ModelNo}}
                                </span>

                                <!-- FIXED: Floor Name from database join -->
                                <span class="asset-detail-item" ng-if="asset.FloorName">
                                    <i class="material-icons">&#xE30A;</i>
                                    {{asset.FloorName}}
                                </span>

                                <!-- FIXED: Last Modified from database -->
                                <span class="asset-detail-item" ng-if="asset.ModifiedDate">
                                    <i class="material-icons">&#xE192;</i>
                                    {{asset.ModifiedDate | jsonDate: "dd-MMM HH:mm"}}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- No assets message -->
                    <div class="no-data-message" ng-if="assetsList.length === 0">
                        <i class="material-icons" style="font-size:48px;color:#bdbdbd;display:block;margin-bottom:12px;">&#xE8B0;</i>
                        No assets found for this floor.
                    </div>
                </div>

            </div>

            <!-- ============================================ -->
            <!-- MULTI-FLOOR MAPS VIEW                         -->
            <!-- Displays multiple floor maps simultaneously  -->
            <!-- ============================================ -->
            <div class="multi-floor-view" ng-show="showMultiFloorView" style="margin-top: 20px;">
                
                <div class="section-header">
                    <button class="back-btn" ng-click="closeMultiFloorView()">
                        <i class="material-icons">&#xE5C4;</i> Back to Floors
                    </button>
                    <h3 class="section-title">
                        Multi-Floor View ({{multiFloorData.floorMaps.length}} floors)
                    </h3>
                </div>

                <!-- Floor Maps Grid -->
                <div class="multi-floor-maps-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 20px; margin-top: 20px;">
                    
                    <div class="floor-map-container" 
                         id="floor-map-{{floor.mFloorMasterId}}"
                         ng-repeat="floor in multiFloorData.floorMaps"
                         style="position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.15); background: #f5f5f5;">
                        
                        <!-- Floor Map Header -->
                        <div style="background: #1976d2; color: #fff; padding: 12px 16px; font-weight: 600; font-size: 16px;">
                            <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">&#xE30A;</i>
                            {{floor.FloorName}} ({{floor.FloorNo}})
                            <span style="font-size: 12px; opacity: 0.9; margin-left: 8px;">- {{floor.ZoneName}}</span>
                        </div>

                        <!-- Floor Map Image -->
                        <div class="floor-map-wrapper" style="position: relative; width: 100%; padding-top: 75%; background: #e0e0e0;">
                            <img ng-if="floor.MapPath" 
                                 src="{{floor.MapPath}}" 
                                 alt="{{floor.FloorName}}"
                                 style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain;" />
                            <div ng-if="!floor.MapPath" 
                                 style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: #9e9e9e;">
                                <i class="material-icons" style="font-size: 64px; display: block; margin-bottom: 12px;">&#xE8B0;</i>
                                No map image available
                            </div>

                            <!-- Asset Marker (RED) - Positioned at X/Y coordinates -->
                            <div ng-if="highlightedAsset && highlightedAsset.location.mFloorMasterId === floor.mFloorMasterId"
                                 class="asset-marker"
                                 style="position: absolute; left: {{highlightedAsset.location.Xaxis}}%; top: {{highlightedAsset.location.Yaxis}}%; transform: translate(-50%, -50%); z-index: 1000;">
                                <div style="background: #f44336; color: #fff; width: 32px; height: 32px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); box-shadow: 0 2px 8px rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; animation: pulse 2s infinite;">
                                    <i class="material-icons" style="transform: rotate(45deg); font-size: 18px;">&#xE8B6;</i>
                                </div>
                                <div style="position: absolute; top: -40px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,.8); color: #fff; padding: 4px 12px; border-radius: 4px; font-size: 11px; white-space: nowrap; font-weight: 600;">
                                    {{highlightedAsset.asset.IteamName || highlightedAsset.asset.AssetID}}
                                </div>
                            </div>
                        </div>

                        <!-- Floor Map Footer -->
                        <div style="padding: 12px 16px; background: #fff; border-top: 1px solid #e0e0e0; font-size: 12px; color: #616161;">
                            <strong>Map ID:</strong> {{floor.MapId || 'N/A'}} | 
                            <strong>Floor ID:</strong> {{floor.mFloorMasterId}}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

