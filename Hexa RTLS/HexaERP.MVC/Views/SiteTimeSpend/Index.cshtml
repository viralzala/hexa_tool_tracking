    <script src="~/Scripts/HexaAgular/SiteTimeSpend.js"></script>
    <script>
        $(document).ready(function () {
            var d = new Date();
            console.log(d);
            console.log('couter');
            function zeroPadded(val) {
                if (val >= 10)
                    return val;
                else
                    return '0' + val;
            }
            $("#dateFrom").val(d.getFullYear() + "-" + zeroPadded(d.getMonth() + 1) + "-" + zeroPadded(d.getDate() - 1));
            $('#toDate').val(d.getFullYear() + "-" + zeroPadded(d.getMonth() + 1) + "-" + zeroPadded(d.getDate()));

        });
    </script>


}

