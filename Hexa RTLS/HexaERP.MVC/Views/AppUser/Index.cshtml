@model HexaERP.MVC.Models.AppUser
@{
    Layout = null;
}

<!--[if lte IE 9]> <html class="lte-ie9" lang="en"> <![endif]-->
<!--[if gt IE 9]><!-->
<html ng-app="app" ng-controller="ctrl" lang="en">
<!--<![endif]-->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />
    @*<link rel="icon" type="image/png" href="~/Content/assets/img/favicon-16x16.png" sizes="16x16">
        <link rel="icon" type="image/png" href="~/Content/assets/img/favicon-32x32.png" sizes="32x32">*@
    <title>Login Page</title>
    <link href='http://fonts.googleapis.com/css?family=Roboto:300,400,500' rel='stylesheet' type='text/css'>
    <!-- uikit -->
    <link rel="stylesheet" href="~/Content/bower_components/uikit/css/uikit.almost-flat.min.css" />
    <!-- altair admin login page -->
    <link rel="stylesheet" href="~/Content/assets/css/login_page.min.css" />

    @Scripts.Render("~/bundles/AngularJS")
    @Scripts.Render("~/bundles/AngularJSTranslate")
</head>

<body class="login_page login_page_v2" ng-cloak>
    <div class="uk-container uk-container-center">
        <div class="md-card">
            <div class="md-card-content padding-reset">
                <div class="uk-grid uk-grid-collapse">
                    <div class="uk-width-large-2-3 uk-hidden-medium uk-hidden-small">
                        <div class="login_page_info uk-height-1-1" style="background-image:url('../../Content/assets/img/HexaTrackico.jpg')">
                            <div class="info_content">
                                @*<img src="~/Content/assets/img/SonicWall_logo_final_white_orangewave_RGB.png" />*@
                                <h1 class="heading_b">Visteon Corporation</h1>
                                @*<p>
                                        <a target="_blank" href="http://hexahash.com">www.hexahash.com</a>
                                    </p>*@
                            </div>
                            <img src="../../Content/assets/img/HexaTrackico.jpg" />
                        </div>
                    </div>
                    <div class="uk-width-large-1-3 uk-width-medium-2-3 uk-container-center">
                        <div class="login_page_forms">
                            <div id="login_card">
                                <div id="login_form">
                                    <div class="login_heading">
                                        <div class="user_avatar"></div>
                                    </div>
                                    @using (Html.BeginForm("", "AppUser", FormMethod.Post, new { id = "_formAuth" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true)
                                        <div class="uk-form-row">
                                            <label for="login_username"><span><b> User Name</b></span></label>
                                            @Html.TextBoxFor(m => m.AppUserName, new { @class = "md-input label-fixed" })
                                        </div>
                                        <div class="uk-form-row">
                                            <label for="login_password"><span><b>Password</b></span></label>
                                            @Html.PasswordFor(m => m.Password, new { @class = "md-input label-fixed" })
                                        </div>
                                        <div class="uk-margin-medium-top">
                                            <input type="submit" id="submit-button" class="md-btn md-btn-primary md-btn-block md-btn-large" value="LogIn">
                                        </div>
                                        <div class="uk-margin-top" title="" style="display:none">
                                            <span class="icheck-inline">
                                                @Html.CheckBoxFor(m => m.IsAllowed, new { @id = "login_page_stay_signed", @class = "data-md-icheck" })
                                            </span>
                                            <label class="uk-text-right uk-text-muted uk-text-small"><b> </b></label>
                                        </div>
                                    }
                                </div>

                                <div class="uk-position-relative" id="login_help" style="display: none">
                                    <button type="button" class="uk-position-top-right uk-close uk-margin-right back_to_login"></button>
                                    <h2 class="heading_b uk-text-success">Can't log in?</h2>
                                    <a href="#" id="password_reset_show">reset your password</a>
                                </div>
                                <div id="login_password_reset" style="display: none">
                                    <button type="button" class="uk-position-top-right uk-close uk-margin-right back_to_login"></button>
                                    <h2 class="heading_a uk-margin-large-bottom">Reset password</h2>
                                    <form>
                                        <div class="uk-form-row">
                                            <label for="login_email_reset">Your email address</label>
                                            <input class="md-input" type="text" id="login_email_reset" name="login_email_reset" />
                                        </div>
                                        <div class="uk-margin-medium-top">
                                            <a href="index.html" class="md-btn md-btn-primary md-btn-block">Reset password</a>
                                        </div>
                                    </form>
                                </div>
                                <div id="register_form" style="display: none">
                                    <button type="button" class="uk-position-top-right uk-close uk-margin-right back_to_login"></button>
                                    <h2 class="heading_a uk-margin-medium-bottom">Create an account</h2>
                                    @using (Html.BeginForm("ChangePassword", "AppUser", FormMethod.Post, new { id = "_formAuthChange" }))
                                    {
                                        //@Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true)
                                        <div class="uk-form-row">
                                            <label for="login_email_reset">User Name</label>
                                            @*@Html.TextBoxFor(m => m.AppUserName, new { @class = "md-input label-fixed" })*@
                                            <input class="md-input" type="text" id="sds" name="NewPassword" />
                                        </div>
                                        <div class="uk-form-row">
                                            <label for="login_email_reset">Old Password</label>
                                            @*<input class="md-input" type="text" id="sdf" name="asda" />*@
                                        </div>
                                        <div class="uk-form-row">
                                            <label for="login_email_reset">New Password</label>
                                            @*<input class="md-input" type="text" id="sdd" name="dfg" />*@
                                        </div>
                                        <div class="uk-margin-medium-top">
                                            <input type="submit" id="submit-sd" class="md-btn md-btn-primary md-btn-block" value="ChangePassword">
                                            @*<a class="md-btn md-btn-primary md-btn-block">Reset password</a>*@
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="uk-margin-top uk-text-center">
                                <a target="_self" href="@Url.Action("","TVDisplayDashboard")">TV Display Dashboard</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- common functions -->
    <script src="~/Content/assets/js/common.min.js"></script>
    <!-- uikit functions -->
    <script src="~/Content//assets/js/uikit_custom.min.js"></script>
    <!-- altair core functions -->
    <script src="~/Content/assets/js/altair_admin_common.min.js"></script>
    <!-- altair login page functions -->
    <script src="~/Content/assets/js/pages/login.min.js"></script>

    @*<script src="~/Scripts/angular-cookies.js"></script>
        <script src="~/Scripts/angular-translate.js"></script>
        <script src="~/Scripts/angular-translate-storage-cookie.js"></script>
        <script src="~/Scripts/angular-translate-storage-local.js"></script>*@

    <script src="~/Scripts/HexaAgular/HexaTranslateProvider.js"></script>

    <script>
        // check for theme
        if (typeof (Storage) !== "undefined") {
            var root = document.getElementsByTagName('html')[0],
                theme = localStorage.getItem("altair_theme");
            if (theme == 'app_theme_dark' || root.classList.contains('app_theme_dark')) {
                root.className += ' app_theme_dark';
            }
        }
    </script>
    @*<script src="~/AppJs/UserLogin.js"></script>*@

    <script>
        $('form').submit(function () {
            var AppUserName = $('#AppUserName').val();
            var Password = $('#Password').val();
            if (AppUserName != '' && Password != '' && AppUserName.length > 0 && Password.length > 0) {
                $("#submit-button").attr("disabled", true).val("Loading..");
            }
            else {
                return false;
            }
        });
    </script>
</body>
</html>