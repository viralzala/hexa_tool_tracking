
@{
    ViewBag.Title = "Index";

    if (Session["SortCode"] != null)
    {
        if (Convert.ToString(Session["SortCode"]) == "SA")
        {
            Layout = "~/Views/Shared/_Site.cshtml";
        }
        else if (Convert.ToString(Session["SortCode"]) == "AD")
        {
            Layout = "~/Views/Shared/_Admin.cshtml";
        }
        else if (new string[] { "OT", "SA" }.Contains(Convert.ToString(Session["SortCode"])))
        {
            Layout = "~/Views/Shared/_Users.cshtml";
        }
    }
    else
    {

    }
}

@section head
{

}

<div id="page_content_inner" ng-controller="UserHomeCtrl">
    <h3 class="heading_b uk-margin-bottom">Dashboard</h3>
</div>
@section foot
{
    <!--  tour functions -->
    <script src="~/Content/bower_components/enjoyhint/enjoyhint.js"></script>
    <script src="~/Content/assets/js/pages/plugins_tour.min.js"></script>

    <!-- page specific plugins -->
    <!--  contact list functions -->
    <script src="@Url.Content("~/Content/assets/js/pages/page_contact_list.min.js")"
            type="text/javascript"></script>
}