    <add key="Smt:TimerIntervalInSeconds" value="60" />
    <add key="Smt:UnknownReader" value="" />
    <!--Out Going SMTP Mail-->
    <add key="EmailId" value="" />
    <add key="EmailServer" value="" />
    <add key="Port" value="25" />
    <add key="IsSSL" value="false" />
    <add key="Password" value="dumy@123" />
    <!--Out Going Trasaction Mail CC-->
    <add key="ticketTo" value="" />
    <add key="ticketCC" value="" />
    <!--Missing Notificaton-->
    <add key="missingTo" value="" />
    <add key="missingCC" value="" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="RssiVal" value="30" />
    <add key="TimerIntervalInMilliseconds" value="300000" />
    <!--Error Log Files-->
    <add key="LogDirectory" value="C:\LogFiles\" />
